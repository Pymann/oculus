# The C interface of liboculus_clang.so, the in-process Clang shim
# (worker/oculus_shim.cpp, doc/inprocess_frontend.md).
#
# This file and the `extern: "C"` block of src/frontend/inproc_frontend.aiml are
# the specification: tools/gen_shim_header.py generates the C header the shim is
# compiled against (out/gen/oculus_shim.h) from the enums here and that block, so
# the two sides cannot drift apart.  (The block lives there because an `extern`
# declaration is visible only in its own file.)  Keep one enum value per line and
# one `def` per line, the generator reads that layout.
#
# A unit is an opaque handle (`ptr`): oc_parse parses one translation unit and
# copies everything Oculus reads out of the AST, the AST is gone when it
# returns.  Every accessor is null-safe and range-checked: a null unit, a wrong
# index or a wrong field gives "" or -1.  Strings come back as fresh AIML
# strings (the shim allocates them with aiml_str_dup).  oc_unit_free releases
# the unit; it is safe on null.

# Bump together with OC_SHIM_ABI in the shim when a signature or a value changes.
- enum:
    name: ClangShimAbi
    wire: true
    values:
      - version: 10

- enum:
    name: ClangUnitText
    wire: true
    values:
      - frontend
      - language
      - standard
      - problem
      - first_error

- enum:
    name: ClangUnitNum
    wire: true
    values:
      - compile_errors
      - file_count
      - type_count
      - decl_count
      - dropped_count
      - node_count
      - macro_count

- enum:
    name: ClangFileText
    wire: true
    values:
      - path
      - kind

- enum:
    name: ClangFileNum
    wire: true
    values:
      - is_main
      - include_guarded
      - first_line
      - first_column
      - included_in_declaration

- enum:
    name: ClangTypeText
    wire: true
    values:
      - kind
      - name
      - array_kind

- enum:
    name: ClangTypeNum
    wire: true
    values:
      - canonical_uid
      - sugar_uid
      - decl_uid
      - is_typedef
      - is_builtin
      - is_bool
      - is_integer
      - int_signed
      - int_width
      - plain_char
      - is_enum
      - is_record
      - is_dependent
      - enum_underlying_uid
      - array_size
      - element_uid
      - is_pointer

- enum:
    name: ClangDeclText
    wire: true
    values:
      - kind
      - name
      - sign_written
      - tag
      - storage
      - target

- enum:
    name: ClangDeclNum
    wire: true
    values:
      - type_uid
      - parent_uid
      - is_definition
      - is_bit_field
      - bit_width
      - written_builtin
      - pos_from_macro
      - in_system_header
      - from_macro
      - from_macro_arg
      - implicit
      - instantiated
      - is_inline
      - is_local
      - is_param
      - param_count
      - virtual_bases
      - is_scoped
      - is_fixed
      - has_init
      - constant_init
      - overrides
      - override_written
      - is_noreturn
      - returns_void
      - explicit_specialization
      - has_restrict
      - in_extern_c
      - is_main
      - field_index
      - field_count
      - in_instantiation
      - array_size_literal
      - is_mutated
      - is_first_decl
      - virtual_written
      - template_specialization
      - external_linkage
      - internal_linkage
      - first_decl_static
      - group_uid
      - odr_definition
      - paren_declarator

- enum:
    name: ClangNodeText
    wire: true
    values:
      - kind
      - detail

- enum:
    name: ClangNodeNum
    wire: true
    values:
      - in_system_header
      - from_macro
      - parent_uid
      - function_uid
      - ref_uid
      - child_count
      - pos_from_macro
      - type_uid
      - is_dependent
      - label_count
      - clause_count
      - has_skipped_code

- enum:
    name: ClangMacroText
    wire: true
    values:
      - kind
      - name
      - body

- enum:
    name: ClangMacroNum
    wire: true
    values:
      - function_like
      - variadic
      - param_count
      - stringize_count
      - paste_count
      - uses_call_site
      - line_count
      - defined_file_uid

# Which position of a macro record.
- enum:
    name: ClangMacroPos
    wire: true
    values:
      - directive
      - name_pos
      - first_operator
      - second_operator
      - stringize_paste

# Which position of a declaration, and which part of it.
- enum:
    name: ClangPosWhich
    wire: true
    values:
      - spelling
      - expansion
      - name_pos
      - instantiation_pos
      - type_pos
      - restrict_pos
      - declarator_pos

- enum:
    name: ClangPosPart
    wire: true
    values:
      - file_uid
      - line
      - column
