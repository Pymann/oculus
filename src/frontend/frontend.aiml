# The frontend turns one translation unit into Oculus' IR.  Everything behind this
# interface is replaceable.  The real one is ClangFrontend
# (src/frontend/clang_frontend.aiml); doc/ir.md describes what it delivers.

- import: "src/ir/ir.aiml"
- import: "src/scan/compile_db.aiml"

- interface:
    name: Frontend
    methods:
      - [frontend_name, string, []]
      - [parse_unit, IrUnit, [[cmd, CompileCommand]]]

# The unit as far as it can be had without a parser: file name, directory,
# language and source text.  Rules that only need the text (line counts) work on it.
- def:
    name: read_unit_text
    args: [[cmd, CompileCommand]]
    return: IrUnit
    body:
      - decl: [unit, IrUnit]
      - decl: [src_name, string, { call: [command_source_path, cmd] }]
      - set: [unit.file_name, src_name]
      - set: [unit.directory, cmd.directory]
      - set: [unit.language, { call: [command_language, cmd] }]
      - decl: [src_path, path, { call: [path.from_string, src_name] }]
      - if:
          condition: { call: [io.is_file, src_path] }
          then:
            - set: [unit.source_text, { call: [io.read_file, src_path] }]
      - return: unit

# Text only, no parser: kept for tests and for running without the Clang worker.
- class:
    name: StubFrontend
    implements: [Frontend]
    methods:
      - def: { name: frontend_name, args: [], return: string, body: [{ return: "stub" }] }
      - def:
          name: parse_unit
          args: [[cmd, CompileCommand]]
          return: IrUnit
          body:
            - return: { call: [read_unit_text, cmd] }
