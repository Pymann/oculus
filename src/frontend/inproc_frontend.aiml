# The in-process path of the Clang frontend: liboculus_clang.so parses the unit
# inside this process and this file copies its records into RuleInformation, one
# accessor call per field (src/frontend/clang_shim.aiml, doc/inprocess_frontend.md).
# No JSON, no second process.  The result is the same RuleInformation the JSON
# worker delivers; tests/run_tests.sh checks both paths against the same expectations.

- import: "src/ir/ir.aiml"
- import: "src/scan/compile_db.aiml"
- import: "src/frontend/clang_shim.aiml"

# The functions of liboculus_clang.so (field ids: the enums of clang_shim.aiml).
# argv: the compiler argv of the compile command, one argument per line ("" = none);
# command: the `command` string of the compile command, used when argv is "".
- extern: "C"
  defs:
    - def: { name: oc_shim_abi, args: [], return: i32 }
    - def: { name: oc_parse, args: [[directory, string], [file, string], [argv, string], [command, string]], return: ptr }
    - def: { name: oc_unit_free, args: [[unit, ptr]], return: void }
    - def: { name: oc_unit_text, args: [[unit, ptr], [field, i32]], return: string }
    - def: { name: oc_unit_num, args: [[unit, ptr], [field, i32]], return: i32 }
    - def: { name: oc_dropped_flag, args: [[unit, ptr], [index, i32]], return: string }
    - def: { name: oc_file_text, args: [[unit, ptr], [index, i32], [field, i32]], return: string }
    - def: { name: oc_file_num, args: [[unit, ptr], [index, i32], [field, i32]], return: i32 }
    - def: { name: oc_type_text, args: [[unit, ptr], [index, i32], [field, i32]], return: string }
    - def: { name: oc_type_num, args: [[unit, ptr], [index, i32], [field, i32]], return: i32 }
    - def: { name: oc_decl_text, args: [[unit, ptr], [index, i32], [field, i32]], return: string }
    - def: { name: oc_decl_num, args: [[unit, ptr], [index, i32], [field, i32]], return: i32 }
    - def: { name: oc_decl_pos, args: [[unit, ptr], [index, i32], [which, i32], [part, i32]], return: i32 }
    - def: { name: oc_node_text, args: [[unit, ptr], [index, i32], [field, i32]], return: string }
    - def: { name: oc_node_num, args: [[unit, ptr], [index, i32], [field, i32]], return: i32 }
    - def: { name: oc_node_pos, args: [[unit, ptr], [index, i32], [which, i32], [part, i32]], return: i32 }
    - def: { name: oc_macro_text, args: [[unit, ptr], [index, i32], [field, i32]], return: string }
    - def: { name: oc_macro_num, args: [[unit, ptr], [index, i32], [field, i32]], return: i32 }
    - def: { name: oc_macro_pos, args: [[unit, ptr], [index, i32], [which, i32], [part, i32]], return: i32 }

- def:
    name: shim_pos
    args: [[unit, ptr], [index, i32], [which, i32]]
    return: IrPos
    body:
      - decl: [pos, IrPos]
      - set: [pos.file_uid, { call: [oc_decl_pos, unit, index, which, ClangPosPart.file_uid] }]
      - set: [pos.line, { call: [oc_decl_pos, unit, index, which, ClangPosPart.line] }]
      - set: [pos.column, { call: [oc_decl_pos, unit, index, which, ClangPosPart.column] }]
      - return: pos

- def:
    name: type_flag
    args: [[unit, ptr], [index, i32], [field, i32]]
    return: bool
    body:
      - return: { eq: [{ call: [oc_type_num, unit, index, field] }, 1] }

- def:
    name: decl_flag
    args: [[unit, ptr], [index, i32], [field, i32]]
    return: bool
    body:
      - return: { eq: [{ call: [oc_decl_num, unit, index, field] }, 1] }

- def:
    name: shim_file
    args: [[unit, ptr], [index, i32]]
    return: IrFile
    body:
      - decl: [file, IrFile]
      - set: [file.uid, index]
      - set: [file.path, { call: [oc_file_text, unit, index, ClangFileText.path] }]
      - set: [file.kind, { call: [oc_file_text, unit, index, ClangFileText.kind] }]
      - set: [file.is_main, { eq: [{ call: [oc_file_num, unit, index, ClangFileNum.is_main] }, 1] }]
      - set: [file.include_guarded, { eq: [{ call: [oc_file_num, unit, index, ClangFileNum.include_guarded] }, 1] }]
      - set: [file.first_line, { call: [oc_file_num, unit, index, ClangFileNum.first_line] }]
      - set: [file.first_column, { call: [oc_file_num, unit, index, ClangFileNum.first_column] }]
      - set: [file.included_in_declaration, { eq: [{ call: [oc_file_num, unit, index, ClangFileNum.included_in_declaration] }, 1] }]
      - set: [file.line_classes, { call: [oc_file_text, unit, index, ClangFileText.line_classes] }]
      - return: file

- def:
    name: shim_type
    args: [[unit, ptr], [index, i32]]
    return: IrType
    body:
      - decl: [rec, IrType]
      - set: [rec.uid, index]
      - set: [rec.kind, { call: [oc_type_text, unit, index, ClangTypeText.kind] }]
      - set: [rec.name, { call: [oc_type_text, unit, index, ClangTypeText.name] }]
      - set: [rec.canonical_uid, { call: [oc_type_num, unit, index, ClangTypeNum.canonical_uid] }]
      - set: [rec.sugar_uid, { call: [oc_type_num, unit, index, ClangTypeNum.sugar_uid] }]
      - set: [rec.decl_uid, { call: [oc_type_num, unit, index, ClangTypeNum.decl_uid] }]
      - set: [rec.is_typedef, { call: [type_flag, unit, index, ClangTypeNum.is_typedef] }]
      - set: [rec.is_builtin, { call: [type_flag, unit, index, ClangTypeNum.is_builtin] }]
      - set: [rec.is_bool, { call: [type_flag, unit, index, ClangTypeNum.is_bool] }]
      - set: [rec.is_integer, { call: [type_flag, unit, index, ClangTypeNum.is_integer] }]
      - set: [rec.int_signed, { call: [type_flag, unit, index, ClangTypeNum.int_signed] }]
      - set: [rec.int_width, { call: [oc_type_num, unit, index, ClangTypeNum.int_width] }]
      - set: [rec.plain_char, { call: [type_flag, unit, index, ClangTypeNum.plain_char] }]
      - set: [rec.is_enum, { call: [type_flag, unit, index, ClangTypeNum.is_enum] }]
      - set: [rec.is_record, { call: [type_flag, unit, index, ClangTypeNum.is_record] }]
      - set: [rec.is_dependent, { call: [type_flag, unit, index, ClangTypeNum.is_dependent] }]
      - set: [rec.enum_underlying_uid, { call: [oc_type_num, unit, index, ClangTypeNum.enum_underlying_uid] }]
      - set: [rec.array_kind, { call: [oc_type_text, unit, index, ClangTypeText.array_kind] }]
      - set: [rec.array_size, { call: [oc_type_num, unit, index, ClangTypeNum.array_size] }]
      - set: [rec.element_uid, { call: [oc_type_num, unit, index, ClangTypeNum.element_uid] }]
      - set: [rec.is_pointer, { call: [type_flag, unit, index, ClangTypeNum.is_pointer] }]
      - return: rec

- def:
    name: shim_decl
    args: [[unit, ptr], [index, i32]]
    return: IrDecl
    body:
      - decl: [rec, IrDecl]
      - set: [rec.uid, index]
      - set: [rec.kind, { call: [oc_decl_text, unit, index, ClangDeclText.kind] }]
      - set: [rec.name, { call: [oc_decl_text, unit, index, ClangDeclText.name] }]
      - set: [rec.pos.spelling, { call: [shim_pos, unit, index, ClangPosWhich.spelling] }]
      - set: [rec.pos.expansion, { call: [shim_pos, unit, index, ClangPosWhich.expansion] }]
      - set: [rec.pos.from_macro, { call: [decl_flag, unit, index, ClangDeclNum.pos_from_macro] }]
      - set: [rec.name_pos, { call: [shim_pos, unit, index, ClangPosWhich.name_pos] }]
      - set: [rec.origin.in_system_header, { call: [decl_flag, unit, index, ClangDeclNum.in_system_header] }]
      - set: [rec.origin.from_macro, { call: [decl_flag, unit, index, ClangDeclNum.from_macro] }]
      - set: [rec.origin.from_macro_arg, { call: [decl_flag, unit, index, ClangDeclNum.from_macro_arg] }]
      - set: [rec.origin.implicit, { call: [decl_flag, unit, index, ClangDeclNum.implicit] }]
      - set: [rec.origin.instantiated, { call: [decl_flag, unit, index, ClangDeclNum.instantiated] }]
      - set: [rec.instantiation_pos, { call: [shim_pos, unit, index, ClangPosWhich.instantiation_pos] }]
      - set: [rec.type_uid, { call: [oc_decl_num, unit, index, ClangDeclNum.type_uid] }]
      - set: [rec.parent_uid, { call: [oc_decl_num, unit, index, ClangDeclNum.parent_uid] }]
      - set: [rec.is_definition, { call: [decl_flag, unit, index, ClangDeclNum.is_definition] }]
      - set: [rec.is_bit_field, { call: [decl_flag, unit, index, ClangDeclNum.is_bit_field] }]
      - set: [rec.bit_width, { call: [oc_decl_num, unit, index, ClangDeclNum.bit_width] }]
      - set: [rec.written_builtin, { call: [decl_flag, unit, index, ClangDeclNum.written_builtin] }]
      - set: [rec.sign_written, { call: [oc_decl_text, unit, index, ClangDeclText.sign_written] }]
      - set: [rec.tag, { call: [oc_decl_text, unit, index, ClangDeclText.tag] }]
      - set: [rec.storage, { call: [oc_decl_text, unit, index, ClangDeclText.storage] }]
      - set: [rec.target, { call: [oc_decl_text, unit, index, ClangDeclText.target] }]
      - set: [rec.is_inline, { call: [decl_flag, unit, index, ClangDeclNum.is_inline] }]
      - set: [rec.is_local, { call: [decl_flag, unit, index, ClangDeclNum.is_local] }]
      - set: [rec.is_param, { call: [decl_flag, unit, index, ClangDeclNum.is_param] }]
      - set: [rec.is_scoped, { call: [decl_flag, unit, index, ClangDeclNum.is_scoped] }]
      - set: [rec.is_fixed, { call: [decl_flag, unit, index, ClangDeclNum.is_fixed] }]
      - set: [rec.has_init, { call: [decl_flag, unit, index, ClangDeclNum.has_init] }]
      - set: [rec.constant_init, { call: [decl_flag, unit, index, ClangDeclNum.constant_init] }]
      - set: [rec.override_written, { call: [decl_flag, unit, index, ClangDeclNum.override_written] }]
      - set: [rec.is_noreturn, { call: [decl_flag, unit, index, ClangDeclNum.is_noreturn] }]
      - set: [rec.returns_void, { call: [decl_flag, unit, index, ClangDeclNum.returns_void] }]
      - set: [rec.explicit_specialization, { call: [decl_flag, unit, index, ClangDeclNum.explicit_specialization] }]
      - set: [rec.has_restrict, { call: [decl_flag, unit, index, ClangDeclNum.has_restrict] }]
      - set: [rec.in_extern_c, { call: [decl_flag, unit, index, ClangDeclNum.in_extern_c] }]
      - set: [rec.is_main, { call: [decl_flag, unit, index, ClangDeclNum.is_main] }]
      - set: [rec.param_count, { call: [oc_decl_num, unit, index, ClangDeclNum.param_count] }]
      - set: [rec.virtual_bases, { call: [oc_decl_num, unit, index, ClangDeclNum.virtual_bases] }]
      - set: [rec.overrides, { call: [oc_decl_num, unit, index, ClangDeclNum.overrides] }]
      - set: [rec.group_uid, { call: [oc_decl_num, unit, index, ClangDeclNum.group_uid] }]
      - set: [rec.field_index, { call: [oc_decl_num, unit, index, ClangDeclNum.field_index] }]
      - set: [rec.field_count, { call: [oc_decl_num, unit, index, ClangDeclNum.field_count] }]
      - set: [rec.in_instantiation, { call: [decl_flag, unit, index, ClangDeclNum.in_instantiation] }]
      - set: [rec.array_size_literal, { call: [decl_flag, unit, index, ClangDeclNum.array_size_literal] }]
      - set: [rec.is_mutated, { call: [decl_flag, unit, index, ClangDeclNum.is_mutated] }]
      - set: [rec.is_first_decl, { call: [decl_flag, unit, index, ClangDeclNum.is_first_decl] }]
      - set: [rec.virtual_written, { call: [decl_flag, unit, index, ClangDeclNum.virtual_written] }]
      - set: [rec.template_specialization, { call: [decl_flag, unit, index, ClangDeclNum.template_specialization] }]
      - set: [rec.external_linkage, { call: [decl_flag, unit, index, ClangDeclNum.external_linkage] }]
      - set: [rec.internal_linkage, { call: [decl_flag, unit, index, ClangDeclNum.internal_linkage] }]
      - set: [rec.first_decl_static, { call: [decl_flag, unit, index, ClangDeclNum.first_decl_static] }]
      - set: [rec.odr_definition, { call: [decl_flag, unit, index, ClangDeclNum.odr_definition] }]
      - set: [rec.paren_declarator, { call: [decl_flag, unit, index, ClangDeclNum.paren_declarator] }]
      - set: [rec.is_explicit, { call: [decl_flag, unit, index, ClangDeclNum.is_explicit] }]
      - set: [rec.is_deleted, { call: [decl_flag, unit, index, ClangDeclNum.is_deleted] }]
      - set: [rec.is_defaulted, { call: [decl_flag, unit, index, ClangDeclNum.is_defaulted] }]
      - set: [rec.min_args, { call: [oc_decl_num, unit, index, ClangDeclNum.min_args] }]
      - set: [rec.type_pos, { call: [shim_pos, unit, index, ClangPosWhich.type_pos] }]
      - set: [rec.restrict_pos, { call: [shim_pos, unit, index, ClangPosWhich.restrict_pos] }]
      - set: [rec.declarator_pos, { call: [shim_pos, unit, index, ClangPosWhich.declarator_pos] }]
      - set: [rec.def_begin, { call: [shim_pos, unit, index, ClangPosWhich.def_begin] }]
      - set: [rec.body_end, { call: [shim_pos, unit, index, ClangPosWhich.body_end] }]
      - set: [rec.body_tokens, { call: [oc_decl_num, unit, index, ClangDeclNum.body_tokens] }]
      - set: [rec.array_param, { call: [decl_flag, unit, index, ClangDeclNum.array_param] }]
      - set: [rec.static_array_pos, { call: [shim_pos, unit, index, ClangPosWhich.static_array_pos] }]
      - set: [rec.copy_or_move, { call: [decl_flag, unit, index, ClangDeclNum.copy_or_move] }]
      - set: [rec.align_count, { call: [oc_decl_num, unit, index, ClangDeclNum.align_count] }]
      - set: [rec.second_align_pos, { call: [shim_pos, unit, index, ClangPosWhich.second_align_pos] }]
      - set: [rec.zero_align_pos, { call: [shim_pos, unit, index, ClangPosWhich.zero_align_pos] }]
      - set: [rec.pointer_pos, { call: [shim_pos, unit, index, ClangPosWhich.pointer_pos] }]
      - set: [rec.ref_qualifier, { call: [oc_decl_text, unit, index, ClangDeclText.ref_qualifier] }]
      - set: [rec.returns_kind, { call: [oc_decl_text, unit, index, ClangDeclText.returns_kind] }]
      - set: [rec.is_referenced, { call: [decl_flag, unit, index, ClangDeclNum.is_referenced] }]
      - set: [rec.maybe_unused, { call: [decl_flag, unit, index, ClangDeclNum.maybe_unused] }]
      - set: [rec.named_in_body, { call: [decl_flag, unit, index, ClangDeclNum.named_in_body] }]
      - return: rec

- def:
    name: shim_node_pos
    args: [[unit, ptr], [index, i32], [which, i32]]
    return: IrPos
    body:
      - decl: [pos, IrPos]
      - set: [pos.file_uid, { call: [oc_node_pos, unit, index, which, ClangPosPart.file_uid] }]
      - set: [pos.line, { call: [oc_node_pos, unit, index, which, ClangPosPart.line] }]
      - set: [pos.column, { call: [oc_node_pos, unit, index, which, ClangPosPart.column] }]
      - return: pos

- def:
    name: shim_node
    args: [[unit, ptr], [index, i32]]
    return: IrNode
    body:
      - decl: [rec, IrNode]
      - set: [rec.uid, index]
      - set: [rec.kind, { call: [oc_node_text, unit, index, ClangNodeText.kind] }]
      - set: [rec.detail, { call: [oc_node_text, unit, index, ClangNodeText.detail] }]
      - set: [rec.spelling, { call: [oc_node_text, unit, index, ClangNodeText.spelling] }]
      - set: [rec.role, { call: [oc_node_text, unit, index, ClangNodeText.role] }]
      - set: [rec.before, { call: [oc_node_text, unit, index, ClangNodeText.before] }]
      - set: [rec.pos.spelling, { call: [shim_node_pos, unit, index, ClangPosWhich.spelling] }]
      - set: [rec.pos.expansion, { call: [shim_node_pos, unit, index, ClangPosWhich.expansion] }]
      - set: [rec.pos.from_macro, { eq: [{ call: [oc_node_num, unit, index, ClangNodeNum.pos_from_macro] }, 1] }]
      - set: [rec.in_system_header, { eq: [{ call: [oc_node_num, unit, index, ClangNodeNum.in_system_header] }, 1] }]
      - set: [rec.from_macro, { eq: [{ call: [oc_node_num, unit, index, ClangNodeNum.from_macro] }, 1] }]
      - set: [rec.parent_uid, { call: [oc_node_num, unit, index, ClangNodeNum.parent_uid] }]
      - set: [rec.function_uid, { call: [oc_node_num, unit, index, ClangNodeNum.function_uid] }]
      - set: [rec.ref_uid, { call: [oc_node_num, unit, index, ClangNodeNum.ref_uid] }]
      - set: [rec.child_count, { call: [oc_node_num, unit, index, ClangNodeNum.child_count] }]
      - set: [rec.type_uid, { call: [oc_node_num, unit, index, ClangNodeNum.type_uid] }]
      - set: [rec.is_dependent, { eq: [{ call: [oc_node_num, unit, index, ClangNodeNum.is_dependent] }, 1] }]
      - set: [rec.label_count, { call: [oc_node_num, unit, index, ClangNodeNum.label_count] }]
      - set: [rec.clause_count, { call: [oc_node_num, unit, index, ClangNodeNum.clause_count] }]
      - set: [rec.has_skipped_code, { eq: [{ call: [oc_node_num, unit, index, ClangNodeNum.has_skipped_code] }, 1] }]
      - set: [rec.macro_body, { eq: [{ call: [oc_node_num, unit, index, ClangNodeNum.macro_body] }, 1] }]
      - set: [rec.side_effect, { eq: [{ call: [oc_node_num, unit, index, ClangNodeNum.side_effect] }, 1] }]
      - return: rec

- def:
    name: shim_macro_pos
    args: [[unit, ptr], [index, i32], [which, i32]]
    return: IrPos
    body:
      - decl: [pos, IrPos]
      - set: [pos.file_uid, { call: [oc_macro_pos, unit, index, which, ClangPosPart.file_uid] }]
      - set: [pos.line, { call: [oc_macro_pos, unit, index, which, ClangPosPart.line] }]
      - set: [pos.column, { call: [oc_macro_pos, unit, index, which, ClangPosPart.column] }]
      - return: pos

- def:
    name: shim_macro
    args: [[unit, ptr], [index, i32]]
    return: IrMacro
    body:
      - decl: [rec, IrMacro]
      - set: [rec.uid, index]
      - set: [rec.kind, { call: [oc_macro_text, unit, index, ClangMacroText.kind] }]
      - set: [rec.name, { call: [oc_macro_text, unit, index, ClangMacroText.name] }]
      - set: [rec.body, { call: [oc_macro_text, unit, index, ClangMacroText.body] }]
      - set: [rec.pos, { call: [shim_macro_pos, unit, index, ClangMacroPos.directive] }]
      - set: [rec.name_pos, { call: [shim_macro_pos, unit, index, ClangMacroPos.name_pos] }]
      - set: [rec.first_operator, { call: [shim_macro_pos, unit, index, ClangMacroPos.first_operator] }]
      - set: [rec.splice_pos, { call: [shim_macro_pos, unit, index, ClangMacroPos.splice_pos] }]
      - set: [rec.second_operator, { call: [shim_macro_pos, unit, index, ClangMacroPos.second_operator] }]
      - set: [rec.stringize_paste, { call: [shim_macro_pos, unit, index, ClangMacroPos.stringize_paste] }]
      - set: [rec.function_like, { eq: [{ call: [oc_macro_num, unit, index, ClangMacroNum.function_like] }, 1] }]
      - set: [rec.variadic, { eq: [{ call: [oc_macro_num, unit, index, ClangMacroNum.variadic] }, 1] }]
      - set: [rec.param_count, { call: [oc_macro_num, unit, index, ClangMacroNum.param_count] }]
      - set: [rec.stringize_count, { call: [oc_macro_num, unit, index, ClangMacroNum.stringize_count] }]
      - set: [rec.paste_count, { call: [oc_macro_num, unit, index, ClangMacroNum.paste_count] }]
      - set: [rec.uses_call_site, { eq: [{ call: [oc_macro_num, unit, index, ClangMacroNum.uses_call_site] }, 1] }]
      - set: [rec.line_count, { call: [oc_macro_num, unit, index, ClangMacroNum.line_count] }]
      - set: [rec.defined_file_uid, { call: [oc_macro_num, unit, index, ClangMacroNum.defined_file_uid] }]
      - return: rec

# Everything of one parsed unit, copied out of the shim.
- def:
    name: shim_info
    args: [[unit, ptr]]
    return: RuleInformation
    body:
      - decl: [info, RuleInformation]
      - set: [info.frontend, { call: [oc_unit_text, unit, ClangUnitText.frontend] }]
      - set: [info.language, { call: [oc_unit_text, unit, ClangUnitText.language] }]
      - set: [info.standard, { call: [oc_unit_text, unit, ClangUnitText.standard] }]
      - set: [info.problem, { call: [oc_unit_text, unit, ClangUnitText.problem] }]
      - set: [info.compile_errors, { call: [oc_unit_num, unit, ClangUnitNum.compile_errors] }]
      - set: [info.first_error, { call: [oc_unit_text, unit, ClangUnitText.first_error] }]
      - decl: [idx, i32, 0]
      - decl: [total, i32, { call: [oc_unit_num, unit, ClangUnitNum.dropped_count] }]
      - while:
          condition: { lt: [idx, total] }
          body:
            - call: [info.dropped_flags.push, { call: [oc_dropped_flag, unit, idx] }]
            - set: [idx, { "+": [idx, 1] }]
      - set: [idx, 0]
      - set: [total, { call: [oc_unit_num, unit, ClangUnitNum.file_count] }]
      - while:
          condition: { lt: [idx, total] }
          body:
            - call: [info.files.push, { call: [shim_file, unit, idx] }]
            - set: [idx, { "+": [idx, 1] }]
      - set: [idx, 0]
      - set: [total, { call: [oc_unit_num, unit, ClangUnitNum.type_count] }]
      - while:
          condition: { lt: [idx, total] }
          body:
            - call: [info.types.push, { call: [shim_type, unit, idx] }]
            - set: [idx, { "+": [idx, 1] }]
      - set: [idx, 0]
      - set: [total, { call: [oc_unit_num, unit, ClangUnitNum.decl_count] }]
      - while:
          condition: { lt: [idx, total] }
          body:
            - call: [info.decls.push, { call: [shim_decl, unit, idx] }]
            - set: [idx, { "+": [idx, 1] }]
      - set: [idx, 0]
      - set: [total, { call: [oc_unit_num, unit, ClangUnitNum.node_count] }]
      - while:
          condition: { lt: [idx, total] }
          body:
            - call: [info.nodes.push, { call: [shim_node, unit, idx] }]
            - set: [idx, { "+": [idx, 1] }]
      - set: [idx, 0]
      - set: [total, { call: [oc_unit_num, unit, ClangUnitNum.macro_count] }]
      - while:
          condition: { lt: [idx, total] }
          body:
            - call: [info.macros.push, { call: [shim_macro, unit, idx] }]
            - set: [idx, { "+": [idx, 1] }]
      - return: info

# Parses one compile command in this process.
- def:
    name: run_shim
    args: [[cmd, CompileCommand]]
    return: RuleInformation
    body:
      - decl: [info, RuleInformation]
      - decl: [abi, i32, { call: [oc_shim_abi] }]
      - if:
          condition: { neq: [abi, ClangShimAbi.version] }
          then:
            - set: [info.problem, "liboculus_clang.so speaks interface ${abi}, oculus expects ${ClangShimAbi.version}: rebuild with worker/build.sh"]
            - return: info
      - decl: [args, list<string>, cmd.arguments]
      - decl: [argv_text, string, { call: [args.join, "\n"] }]
      - decl: [unit, ptr, { call: [oc_parse, cmd.directory, cmd.file, argv_text, cmd.command] }]
      - if:
          condition: { eq: [unit, null] }
          then:
            - set: [info.problem, "the Clang shim could not parse ${cmd.file}"]
            - return: info
      - set: [info, { call: [shim_info, unit] }]
      - call: [oc_unit_free, unit]
      - return: info
