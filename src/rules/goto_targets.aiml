# OC-0105 goto_forward_only, OC-0106 goto_into_enclosing_block and OC-0112
# case_label_placement (catalogue in Pymann/coding-rules).  Read from
# RuleInformation.nodes: GotoStmt and LabelStmt (ref_uid: the label), case and
# default labels, and the parent chain.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"

# The LabelStmt node of each label declaration, by the label's uid as key.
- def:
    name: label_nodes
    args: [[info, RuleInformation]]
    return: map<string:i32>
    body:
      - decl: [found, map<string:i32>]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, info.nodes.len] }
          body:
            - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
            - if:
                condition: { eq: [{ call: [regex.search, "^LabelStmt$", rec.kind] }, 0] }
                then: [{ call: [found.set, "${rec.ref_uid}", rec.uid] }]
            - set: [idx, { "+": [idx, 1] }]
      - return: found

# Is the label written before the goto (a backward jump)?
- def:
    name: jumps_back
    args: [[info, RuleInformation], [labels, map<string:i32>], [rec, ref<IrNode>]]
    return: bool
    body:
      - decl: [target, i32, { call: [labels.get, "${rec.ref_uid}", -1] }]
      - if: { condition: { eq: [{ call: [info_has_node, info, target] }, false] }, then: [{ return: false }] }
      - decl: [label, ref<IrNode>, { at: [info.nodes, target] }]
      - decl: [here, IrPos, rec.pos.expansion]
      - decl: [there, IrPos, label.pos.expansion]
      - if: { condition: { neq: [here.file_uid, there.file_uid] }, then: [{ return: false }] }
      - if: { condition: { lt: [there.line, here.line] }, then: [{ return: true }] }
      - return: { "&&": [{ eq: [there.line, here.line] }, { lt: [there.column, here.column] }] }

# The statement a label belongs to: its first ancestor that is not a label.
- def:
    name: label_anchor
    args: [[info, RuleInformation], [node_uid, i32]]
    return: i32
    body:
      - decl: [cursor, i32, node_uid]
      - while:
          condition: { call: [info_has_node, info, cursor] }
          body:
            - decl: [upper, ref<IrNode>, { at: [info.nodes, cursor] }]
            - if: { condition: { neq: [{ call: [regex.search, "^(LabelStmt|CaseStmt|DefaultStmt)$", upper.kind] }, 0] }, then: [{ return: cursor }] }
            - set: [cursor, upper.parent_uid]
      - return: -1

- def:
    name: has_ancestor
    args: [[info, RuleInformation], [node_uid, i32], [ancestor, i32]]
    return: bool
    body:
      - decl: [cursor, i32, node_uid]
      - while:
          condition: { call: [info_has_node, info, cursor] }
          body:
            - if: { condition: { eq: [cursor, ancestor] }, then: [{ return: true }] }
            - decl: [upper, ref<IrNode>, { at: [info.nodes, cursor] }]
            - set: [cursor, upper.parent_uid]
      - return: false

# Does the goto jump into a block that does not enclose it?
- def:
    name: jumps_inside
    args: [[info, RuleInformation], [labels, map<string:i32>], [rec, ref<IrNode>]]
    return: bool
    body:
      - decl: [target, i32, { call: [labels.get, "${rec.ref_uid}", -1] }]
      - if: { condition: { eq: [{ call: [info_has_node, info, target] }, false] }, then: [{ return: false }] }
      - decl: [label, ref<IrNode>, { at: [info.nodes, target] }]
      - decl: [anchor, i32, { call: [label_anchor, info, label.parent_uid] }]
      - if: { condition: { lt: [anchor, 0] }, then: [{ return: false }] }
      - return: { eq: [{ call: [has_ancestor, info, rec.uid, anchor] }, false] }

# Is the case or default label anywhere but directly in its switch's body?
- def:
    name: misplaced_label
    args: [[info, RuleInformation], [rec, ref<IrNode>]]
    return: bool
    body:
      - decl: [anchor, i32, { call: [label_anchor, info, rec.parent_uid] }]
      - if: { condition: { eq: [{ call: [info_has_node, info, anchor] }, false] }, then: [{ return: false }] }
      - decl: [holder, ref<IrNode>, { at: [info.nodes, anchor] }]
      - if: { condition: { eq: [{ call: [regex.search, "^SwitchStmt$", holder.kind] }, 0] }, then: [{ return: false }] }
      - if: { condition: { neq: [{ call: [regex.search, "^CompoundStmt$", holder.kind] }, 0] }, then: [{ return: true }] }
      - if: { condition: { eq: [{ call: [info_has_node, info, holder.parent_uid] }, false] }, then: [{ return: true }] }
      - decl: [outer, ref<IrNode>, { at: [info.nodes, holder.parent_uid] }]
      - return: { neq: [{ call: [regex.search, "^SwitchStmt$", outer.kind] }, 0] }

- class:
    name: GotoForwardOnlyRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 105, "safety.c90-.4.2.goto_forward_only", "goto jumps only forward within the same function", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [labels, map<string:i32>, { call: [label_nodes, info] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_node, rec] }, { eq: [{ call: [regex.search, "^GotoStmt$", rec.kind] }, 0] }, { call: [jumps_back, info, labels, rec] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 105, "goto '${rec.detail}' jumps backward; write the loop as a loop"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: GotoIntoEnclosingBlockRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 106, "safety.c90-.4.2.goto_into_enclosing_block", "goto targets a label in its own block or an enclosing one", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [labels, map<string:i32>, { call: [label_nodes, info] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_node, rec] }, { eq: [{ call: [regex.search, "^GotoStmt$", rec.kind] }, 0] }, { call: [jumps_inside, info, labels, rec] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 106, "goto '${rec.detail}' jumps into a block that does not enclose it"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: CaseLabelPlacementRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 112, "safety.c90-.4.5.case_label_placement", "Case labels appear only directly in the body of their switch", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_node, rec] }, { eq: [{ call: [regex.search, "^(CaseStmt|DefaultStmt)$", rec.kind] }, 0] }, { call: [misplaced_label, info, rec] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 112, "this label is nested inside another statement of its switch; put it directly in the switch body"] }]
                  - set: [idx, { "+": [idx, 1] }]
