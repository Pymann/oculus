# OC-0183 no_small_int_constant_macros, OC-0369 no_constant_assert and OC-0370
# errno_set_only_to_zero (catalogue in Pymann/coding-rules).  Read from
# RuleInformation: the expansions of system macros in the user's code (an assert
# carries its argument tokens) and IrNode.errno_write.  An assert argument counts
# as constant when it has only literals, true, false, !, &&, || and parentheses.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"

# Is the node's expansion in a file of the user?
- def:
    name: expanded_in_user_file
    args: [[info, RuleInformation], [pos, IrPos]]
    return: bool
    body:
      - if: { condition: { "||": [{ lt: [pos.file_uid, 0] }, { gte: [pos.file_uid, info.files.len] }] }, then: [{ return: false }] }
      - decl: [file, ref<IrFile>, { at: [info.files, pos.file_uid] }]
      - return: { eq: [{ call: [regex.search, "^(source|header)$", file.kind] }, 0] }

- class:
    name: SmallIntConstantMacroRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 183, "style.c99-.3.3.no_small_int_constant_macros", "INT8_C, UINT16_C and similar small variants are not used", "warn", "c"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.macros.len] }
                body:
                  - decl: [rec, ref<IrMacro>, { at: [info.macros, idx] }]
                  - if:
                      condition: { "&&": [{ eq: [{ call: [regex.search, "^expansion$", rec.kind] }, 0] }, { eq: [{ call: [regex.search, "^U?INT(8|16)_C$", rec.name] }, 0] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.pos, 183, "${rec.name} gives an int, not the small type; write a cast of a suffixed literal"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: ConstantAssertRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 369, "style.c90-.13.2.no_constant_assert", "assert is not given a constant expression", "warn", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.macros.len] }
                body:
                  - decl: [rec, ref<IrMacro>, { at: [info.macros, idx] }]
                  - if:
                      condition: { "&&": [{ eq: [{ call: [regex.search, "^expansion$", rec.kind] }, 0] }, { eq: [{ call: [regex.search, "^assert$", rec.name] }, 0] }, { gt: [rec.argument_pos.line, 0] }, { eq: [{ call: [regex.search, "^(\\(|\\)|!|&&|\\|\\||true|false|[0-9][0-9A-Za-z_.']*|\"([^\"\\\\]|\\\\.)*\")( (\\(|\\)|!|&&|\\|\\||true|false|[0-9][0-9A-Za-z_.']*|\"([^\"\\\\]|\\\\.)*\"))*$", rec.body] }, 0] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.argument_pos, 369, "assert of a constant; use static_assert, or abort() for code that must not be reached"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: ErrnoZeroRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 370, "safety.c90-.13.5.errno_set_only_to_zero", "errno is only ever set to zero", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [rec.errno_write, { call: [expanded_in_user_file, info, rec.pos.expansion] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.pos.expansion, 370, "errno is set to a value other than 0; return the error instead"] }]
                  - set: [idx, { "+": [idx, 1] }]
