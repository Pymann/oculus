            - decl: [sized_designated, ptr<Rule>, { new: SizedDesignatedArrayRule }]
            - call: [<.rules.push, sized_designated]
            - decl: [small_int_macro, ptr<Rule>, { new: SmallIntConstantMacroRule }]
            - call: [<.rules.push, small_int_macro]
            - decl: [constant_assert, ptr<Rule>, { new: ConstantAssertRule }]
