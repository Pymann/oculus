# All rules Oculus knows, and which of them a scan runs.

- import: "src/rules/rule.aiml"
- import: "src/rules/file_length.aiml"
- import: "src/rules/bitfield_type.aiml"
- import: "src/rules/unions.aiml"
- import: "src/rules/flexible_arrays.aiml"
- import: "src/rules/enums.aiml"
- import: "src/rules/scope_decls.aiml"
- import: "src/rules/inheritance.aiml"
- import: "src/rules/jumps.aiml"
- import: "src/rules/switches.aiml"
- import: "src/rules/operators.aiml"
- import: "src/rules/handlers.aiml"

- class:
    name: RuleRegistry
    members:
      - [rules, list<ptr<Rule>>, null, { access: public }]
    methods:
      - def:
          name: register_builtin
          args: []
          return: void
          body:
            - decl: [file_length, ptr<Rule>, { new: FileLengthRule }]
            - call: [<.rules.push, file_length]
            - decl: [bitfield_type, ptr<Rule>, { new: BitfieldTypeRule }]
            - call: [<.rules.push, bitfield_type]
            - decl: [no_union, ptr<Rule>, { new: NoUnionRule }]
            - call: [<.rules.push, no_union]
            - decl: [no_bitfield_in_union, ptr<Rule>, { new: NoBitfieldInUnionRule }]
            - call: [<.rules.push, no_bitfield_in_union]
            - decl: [no_bitfields, ptr<Rule>, { new: NoBitfieldsRule }]
            - call: [<.rules.push, no_bitfields]
            - decl: [no_flexible_array, ptr<Rule>, { new: NoFlexibleArrayRule }]
            - call: [<.rules.push, no_flexible_array]
            - decl: [flexible_array_syntax, ptr<Rule>, { new: FlexibleArraySyntaxRule }]
            - call: [<.rules.push, flexible_array_syntax]
            - decl: [no_unscoped_enum, ptr<Rule>, { new: NoUnscopedEnumRule }]
            - call: [<.rules.push, no_unscoped_enum]
            - decl: [enum_underlying_type, ptr<Rule>, { new: EnumUnderlyingTypeRule }]
            - call: [<.rules.push, enum_underlying_type]
            - decl: [no_static_local, ptr<Rule>, { new: NoStaticLocalRule }]
            - call: [<.rules.push, no_static_local]
            - decl: [no_block_function, ptr<Rule>, { new: NoBlockScopeFunctionRule }]
            - call: [<.rules.push, no_block_function]
            - decl: [no_using_directive, ptr<Rule>, { new: NoUsingDirectiveRule }]
            - call: [<.rules.push, no_using_directive]
            - decl: [no_virtual_base, ptr<Rule>, { new: NoVirtualBaseRule }]
            - call: [<.rules.push, no_virtual_base]
            - decl: [no_goto, ptr<Rule>, { new: NoGotoRule }]
            - call: [<.rules.push, no_goto]
            - decl: [no_unused_label, ptr<Rule>, { new: NoUnusedLabelRule }]
            - call: [<.rules.push, no_unused_label]
            - decl: [final_else, ptr<Rule>, { new: FinalElseRule }]
            - call: [<.rules.push, final_else]
            - decl: [switch_default, ptr<Rule>, { new: SwitchHasDefaultRule }]
            - call: [<.rules.push, switch_default]
            - decl: [two_clauses, ptr<Rule>, { new: TwoOrMoreClausesRule }]
            - call: [<.rules.push, two_clauses]
            - decl: [default_place, ptr<Rule>, { new: DefaultFirstOrLastRule }]
            - call: [<.rules.push, default_place]
            - decl: [no_comma, ptr<Rule>, { new: NoCommaOperatorRule }]
            - call: [<.rules.push, no_comma]
            - decl: [no_reinterpret, ptr<Rule>, { new: NoReinterpretCastRule }]
            - call: [<.rules.push, no_reinterpret]
            - decl: [no_unary_plus, ptr<Rule>, { new: NoUnaryPlusRule }]
            - call: [<.rules.push, no_unary_plus]
            - decl: [rethrow_handler, ptr<Rule>, { new: RethrowInHandlerRule }]
            - call: [<.rules.push, rethrow_handler]
      - def:
          name: rule_count
          args: []
          return: i32
          body:
            - return: <.rules.len
