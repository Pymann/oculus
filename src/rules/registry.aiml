            - decl: [memory_management, ptr<Rule>, { new: NoAdvancedMemoryManagementRule }]
            - call: [<.rules.push, memory_management]
            - decl: [raw_smart, ptr<Rule>, { new: NoRawSmartPointerCtorRule }]
            - call: [<.rules.push, raw_smart]
            - decl: [unused_param, ptr<Rule>, { new: NoUnusedParameterRule }]
            - call: [<.rules.push, unused_param]
            - call: [<.register_later]

      # The second half of the built-in rules (a function has at most 300 lines).
      - def:
          name: register_later
          args: []
          return: void
          body:
            - decl: [unused_local, ptr<Rule>, { new: NoUnusedLocalRule }]
            - call: [<.rules.push, unused_local]
            - decl: [comment_open, ptr<Rule>, { new: CommentStartInCommentRule }]
            - call: [<.rules.push, comment_open]
            - decl: [comment_splice, ptr<Rule>, { new: LineCommentSpliceRule }]
            - call: [<.rules.push, comment_splice]
            - decl: [open_escape, ptr<Rule>, { new: TerminatedEscapeRule }]
            - call: [<.rules.push, open_escape]
            - decl: [odd_escape, ptr<Rule>, { new: StandardEscapeRule }]
            - call: [<.rules.push, odd_escape]
            - decl: [trigraphs, ptr<Rule>, { new: NoTrigraphsRule }]
