            - call: [<.rules.push, incomplete_cast]
            - decl: [object_cast, ptr<Rule>, { new: ObjectPointerCastRule }]
            - call: [<.rules.push, object_cast]
            - decl: [pointer_int, ptr<Rule>, { new: PointerIntegerCastRule }]
            - call: [<.rules.push, pointer_int]
            - decl: [void_object, ptr<Rule>, { new: VoidPointerObjectRule }]
            - call: [<.rules.push, void_object]
            - decl: [void_arith, ptr<Rule>, { new: VoidPointerArithmeticRule }]
            - call: [<.rules.push, void_arith]
            - decl: [keep_cv, ptr<Rule>, { new: KeepQualifiersRule }]
            - call: [<.rules.push, keep_cv]
            - decl: [bool_condition, ptr<Rule>, { new: BooleanConditionRule }]
            - call: [<.rules.push, bool_condition]
            - decl: [defined_ident, ptr<Rule>, { new: DefinedConditionIdentifierRule }]
            - call: [<.rules.push, defined_ident]
            - decl: [use_result, ptr<Rule>, { new: UseReturnValueRule }]
            - call: [<.rules.push, use_result]
            - decl: [args_directive, ptr<Rule>, { new: DirectiveInArgumentsRule }]
            - call: [<.rules.push, args_directive]
            - decl: [valid_directive, ptr<Rule>, { new: ValidDirectiveRule }]
            - call: [<.rules.push, valid_directive]
      - def:
          name: rule_count
          args: []
          return: i32
          body:
            - return: <.rules.len
