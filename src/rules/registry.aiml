            - decl: [virtual_member_compare, ptr<Rule>, { new: VirtualMemberCompareRule }]
            - call: [<.rules.push, virtual_member_compare]
            - decl: [nullptr_only, ptr<Rule>, { new: NullptrOnlyRule }]
            - call: [<.rules.push, nullptr_only]
            - decl: [null_integer, ptr<Rule>, { new: NoNullAsIntegerRule }]
            - call: [<.rules.push, null_integer]
            - decl: [abstract_copy, ptr<Rule>, { new: AbstractCopyAssignmentRule }]
            - call: [<.rules.push, abstract_copy]
            - decl: [template_ctor, ptr<Rule>, { new: TemplateCtorCopyRule }]
            - call: [<.rules.push, template_ctor]
            - decl: [template_assign, ptr<Rule>, { new: TemplateAssignCopyRule }]
            - call: [<.rules.push, template_assign]
            - decl: [pure_override, ptr<Rule>, { new: PureOverrideRule }]
            - call: [<.rules.push, pure_override]
            - decl: [override_defaults, ptr<Rule>, { new: OverrideDefaultArgumentsRule }]
            - call: [<.rules.push, override_defaults]
            - decl: [must_not_throw, ptr<Rule>, { new: NoexceptSpecialFunctionsRule }]
