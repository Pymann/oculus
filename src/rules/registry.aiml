# All rules Oculus knows, and which of them a scan runs.

- import: "src/rules/rule.aiml"
- import: "src/rules/file_length.aiml"
- import: "src/rules/bitfield_type.aiml"
- import: "src/rules/unions.aiml"
- import: "src/rules/flexible_arrays.aiml"
- import: "src/rules/enums.aiml"
- import: "src/rules/scope_decls.aiml"
- import: "src/rules/inheritance.aiml"
- import: "src/rules/jumps.aiml"
- import: "src/rules/switches.aiml"
- import: "src/rules/operators.aiml"
- import: "src/rules/handlers.aiml"
- import: "src/rules/macro_operators.aiml"
- import: "src/rules/macro_names.aiml"
- import: "src/rules/directives.aiml"
- import: "src/rules/overrides.aiml"
- import: "src/rules/c_functions.aiml"
- import: "src/rules/decl_shapes.aiml"
- import: "src/rules/library_calls.aiml"
- import: "src/rules/library_time.aiml"
- import: "src/rules/goto_targets.aiml"
- import: "src/rules/linkage.aiml"
- import: "src/rules/library_unsafe.aiml"
- import: "src/rules/library_cxx.aiml"
- import: "src/rules/overloads.aiml"
- import: "src/rules/decl_layout.aiml"
- import: "src/rules/header_contents.aiml"
- import: "src/rules/cxx_scope.aiml"
- import: "src/rules/library_locale.aiml"
- import: "src/rules/banned_headers.aiml"
- import: "src/rules/library_stdio.aiml"
- import: "src/rules/system_macros.aiml"
- import: "src/rules/exceptions.aiml"
- import: "src/rules/bits_pointers_switch.aiml"
- import: "src/rules/literals.aiml"
- import: "src/rules/statement_shapes.aiml"
- import: "src/rules/constructors.aiml"
- import: "src/rules/cxx_casts_operators.aiml"
- import: "src/rules/macro_shapes.aiml"
- import: "src/rules/function_size.aiml"
- import: "src/rules/function_paths.aiml"
- import: "src/rules/file_lines.aiml"
- import: "src/rules/exits.aiml"
- import: "src/rules/array_params.aiml"
- import: "src/rules/cxx_operands.aiml"
- import: "src/rules/assignments.aiml"
- import: "src/rules/alignment.aiml"
- import: "src/rules/generic_selection.aiml"
- import: "src/rules/c_declarations.aiml"
- import: "src/rules/expression_shapes.aiml"

- class:
    name: RuleRegistry
    members:
      - [rules, list<ptr<Rule>>, null, { access: public }]
    methods:
      - def:
          name: register_builtin
          args: []
          return: void
          body:
            - decl: [file_length, ptr<Rule>, { new: FileLengthRule }]
            - call: [<.rules.push, file_length]
            - decl: [bitfield_type, ptr<Rule>, { new: BitfieldTypeRule }]
            - call: [<.rules.push, bitfield_type]
            - decl: [no_union, ptr<Rule>, { new: NoUnionRule }]
            - call: [<.rules.push, no_union]
            - decl: [no_bitfield_in_union, ptr<Rule>, { new: NoBitfieldInUnionRule }]
            - call: [<.rules.push, no_bitfield_in_union]
            - decl: [no_bitfields, ptr<Rule>, { new: NoBitfieldsRule }]
            - call: [<.rules.push, no_bitfields]
            - decl: [no_flexible_array, ptr<Rule>, { new: NoFlexibleArrayRule }]
            - call: [<.rules.push, no_flexible_array]
            - decl: [flexible_array_syntax, ptr<Rule>, { new: FlexibleArraySyntaxRule }]
            - call: [<.rules.push, flexible_array_syntax]
            - decl: [no_unscoped_enum, ptr<Rule>, { new: NoUnscopedEnumRule }]
            - call: [<.rules.push, no_unscoped_enum]
            - decl: [enum_underlying_type, ptr<Rule>, { new: EnumUnderlyingTypeRule }]
            - call: [<.rules.push, enum_underlying_type]
            - decl: [no_static_local, ptr<Rule>, { new: NoStaticLocalRule }]
            - call: [<.rules.push, no_static_local]
            - decl: [no_block_function, ptr<Rule>, { new: NoBlockScopeFunctionRule }]
            - call: [<.rules.push, no_block_function]
            - decl: [no_using_directive, ptr<Rule>, { new: NoUsingDirectiveRule }]
            - call: [<.rules.push, no_using_directive]
            - decl: [no_virtual_base, ptr<Rule>, { new: NoVirtualBaseRule }]
            - call: [<.rules.push, no_virtual_base]
            - decl: [no_goto, ptr<Rule>, { new: NoGotoRule }]
            - call: [<.rules.push, no_goto]
            - decl: [no_unused_label, ptr<Rule>, { new: NoUnusedLabelRule }]
            - call: [<.rules.push, no_unused_label]
            - decl: [final_else, ptr<Rule>, { new: FinalElseRule }]
            - call: [<.rules.push, final_else]
            - decl: [switch_default, ptr<Rule>, { new: SwitchHasDefaultRule }]
            - call: [<.rules.push, switch_default]
            - decl: [two_clauses, ptr<Rule>, { new: TwoOrMoreClausesRule }]
            - call: [<.rules.push, two_clauses]
            - decl: [default_place, ptr<Rule>, { new: DefaultFirstOrLastRule }]
            - call: [<.rules.push, default_place]
            - decl: [no_comma, ptr<Rule>, { new: NoCommaOperatorRule }]
            - call: [<.rules.push, no_comma]
            - decl: [no_reinterpret, ptr<Rule>, { new: NoReinterpretCastRule }]
            - call: [<.rules.push, no_reinterpret]
            - decl: [no_unary_plus, ptr<Rule>, { new: NoUnaryPlusRule }]
            - call: [<.rules.push, no_unary_plus]
            - decl: [rethrow_handler, ptr<Rule>, { new: RethrowInHandlerRule }]
            - call: [<.rules.push, rethrow_handler]
            - decl: [no_stringize, ptr<Rule>, { new: NoStringizeOrPasteRule }]
            - call: [<.rules.push, no_stringize]
            - decl: [stringize_paste, ptr<Rule>, { new: NoStringizeThenPasteRule }]
            - call: [<.rules.push, stringize_paste]
            - decl: [single_operator, ptr<Rule>, { new: SingleStringizeOrPasteRule }]
            - call: [<.rules.push, single_operator]
            - decl: [no_undef, ptr<Rule>, { new: NoUndefRule }]
            - call: [<.rules.push, no_undef]
            - decl: [undef_local, ptr<Rule>, { new: UndefLocalMacrosOnlyRule }]
            - call: [<.rules.push, undef_local]
            - decl: [keyword_macro, ptr<Rule>, { new: NoKeywordMacroRule }]
            - call: [<.rules.push, keyword_macro]
            - decl: [no_pragma, ptr<Rule>, { new: NoPragmaRule }]
            - call: [<.rules.push, no_pragma]
            - decl: [include_guards, ptr<Rule>, { new: IncludeGuardsRule }]
            - call: [<.rules.push, include_guards]
            - decl: [marked_override, ptr<Rule>, { new: MarkedOverrideRule }]
            - call: [<.rules.push, marked_override]
            - decl: [no_template_spec, ptr<Rule>, { new: NoFunctionTemplateSpecializationRule }]
            - call: [<.rules.push, no_template_spec]
            - decl: [main_only, ptr<Rule>, { new: MainOnlyGlobalRule }]
            - call: [<.rules.push, main_only]
            - decl: [noreturn_void, ptr<Rule>, { new: NoreturnIsVoidRule }]
            - call: [<.rules.push, noreturn_void]
            - decl: [inline_static, ptr<Rule>, { new: InlineIsStaticRule }]
            - call: [<.rules.push, inline_static]
            - decl: [no_restrict, ptr<Rule>, { new: NoRestrictRule }]
            - call: [<.rules.push, no_restrict]
            - decl: [external_array, ptr<Rule>, { new: ExternalArraySizeRule }]
            - call: [<.rules.push, external_array]
            - decl: [enum_init, ptr<Rule>, { new: EnumInitializeFirstOrAllRule }]
            - call: [<.rules.push, enum_init]
            - decl: [parameter_count, ptr<Rule>, { new: ParameterCountRule }]
            - call: [<.rules.push, parameter_count]
            - decl: [no_heap, ptr<Rule>, { new: NoHeapRule }]
            - call: [<.rules.push, no_heap]
            - decl: [no_ato, ptr<Rule>, { new: NoAtoConversionsRule }]
            - call: [<.rules.push, no_ato]
            - decl: [no_abort_exit, ptr<Rule>, { new: NoAbortExitGetenvSystemRule }]
            - call: [<.rules.push, no_abort_exit]
            - decl: [no_bsearch_qsort, ptr<Rule>, { new: NoBsearchQsortRule }]
            - call: [<.rules.push, no_bsearch_qsort]
            - decl: [no_time, ptr<Rule>, { new: NoTimeFunctionsRule }]
            - call: [<.rules.push, no_time]
            - decl: [goto_forward, ptr<Rule>, { new: GotoForwardOnlyRule }]
            - call: [<.rules.push, goto_forward]
            - decl: [goto_enclosing, ptr<Rule>, { new: GotoIntoEnclosingBlockRule }]
            - call: [<.rules.push, goto_enclosing]
            - decl: [case_placement, ptr<Rule>, { new: CaseLabelPlacementRule }]
            - call: [<.rules.push, case_placement]
            - decl: [static_internal, ptr<Rule>, { new: StaticOnInternalDeclsRule }]
            - call: [<.rules.push, static_internal]
            - decl: [no_system, ptr<Rule>, { new: NoSystemRule }]
            - call: [<.rules.push, no_system]
            - decl: [no_rand, ptr<Rule>, { new: NoRandRule }]
            - call: [<.rules.push, no_rand]
            - decl: [no_unbounded, ptr<Rule>, { new: NoUnboundedStringFunctionsRule }]
            - call: [<.rules.push, no_unbounded]
            - decl: [no_c_string, ptr<Rule>, { new: NoCStringFunctionsRule }]
            - call: [<.rules.push, no_c_string]
            - decl: [no_ctype, ptr<Rule>, { new: NoCtypeFunctionsRule }]
            - call: [<.rules.push, no_ctype]
            - decl: [no_mem, ptr<Rule>, { new: NoMemFunctionsRule }]
            - call: [<.rules.push, no_mem]
            - decl: [no_address_of, ptr<Rule>, { new: NoOverloadedAddressOfRule }]
            - call: [<.rules.push, no_address_of]
            - decl: [no_logical_overload, ptr<Rule>, { new: NoOverloadedLogicalOrCommaRule }]
            - call: [<.rules.push, no_logical_overload]
            - decl: [no_asm, ptr<Rule>, { new: NoAsmRule }]
            - call: [<.rules.push, no_asm]
            - decl: [single_declarator, ptr<Rule>, { new: SingleDeclaratorRule }]
            - call: [<.rules.push, single_declarator]
            - decl: [no_decl_first_case, ptr<Rule>, { new: NoDeclBeforeFirstCaseRule }]
            - call: [<.rules.push, no_decl_first_case]
            - decl: [unnamed_ns_header, ptr<Rule>, { new: NoUnnamedNamespaceInHeaderRule }]
            - call: [<.rules.push, unnamed_ns_header]
            - decl: [using_header, ptr<Rule>, { new: NoUsingInHeaderRule }]
            - call: [<.rules.push, using_header]
            - decl: [external_def_header, ptr<Rule>, { new: NoExternalDefinitionInHeaderRule }]
            - call: [<.rules.push, external_def_header]
            - decl: [global_ns, ptr<Rule>, { new: GlobalNamespaceContentsRule }]
            - call: [<.rules.push, global_ns]
            - decl: [cast_statement, ptr<Rule>, { new: NoCastStatementRule }]
            - call: [<.rules.push, cast_statement]
            - decl: [c_arrays, ptr<Rule>, { new: NoCArraysRule }]
            - call: [<.rules.push, c_arrays]
            - decl: [set_locale, ptr<Rule>, { new: NoSetlocaleRule }]
            - call: [<.rules.push, set_locale]
            - decl: [no_setjmp, ptr<Rule>, { new: NoSetjmpRule }]
            - call: [<.rules.push, no_setjmp]
            - decl: [no_signal, ptr<Rule>, { new: NoSignalRule }]
            - call: [<.rules.push, no_signal]
            - decl: [no_tgmath, ptr<Rule>, { new: NoTgmathRule }]
            - call: [<.rules.push, no_tgmath]
            - decl: [no_fenv, ptr<Rule>, { new: NoFenvRule }]
            - call: [<.rules.push, no_fenv]
            - decl: [no_stdio, ptr<Rule>, { new: NoStdioRule }]
            - call: [<.rules.push, no_stdio]
            - decl: [no_offsetof, ptr<Rule>, { new: NoOffsetofRule }]
            - call: [<.rules.push, no_offsetof]
            - decl: [no_errno, ptr<Rule>, { new: NoErrnoRule }]
            - call: [<.rules.push, no_errno]
            - decl: [pointer_exception, ptr<Rule>, { new: NoPointerExceptionRule }]
            - call: [<.rules.push, pointer_exception]
            - decl: [throw_null, ptr<Rule>, { new: NoThrowNullRule }]
            - call: [<.rules.push, throw_null]
            - decl: [catch_reference, ptr<Rule>, { new: CatchByReferenceRule }]
            - call: [<.rules.push, catch_reference]
            - decl: [signed_bit, ptr<Rule>, { new: NoSignedSingleBitFieldRule }]
            - call: [<.rules.push, signed_bit]
            - decl: [pointer_levels_rule, ptr<Rule>, { new: MaxTwoPointerLevelsRule }]
            - call: [<.rules.push, pointer_levels_rule]
            - decl: [boolean_switch, ptr<Rule>, { new: NoBooleanSwitchRule }]
            - call: [<.rules.push, boolean_switch]
            - decl: [octal_literal_rule, ptr<Rule>, { new: NoOctalLiteralRule }]
            - call: [<.rules.push, octal_literal_rule]
            - decl: [lowercase_suffix_rule, ptr<Rule>, { new: NoLowercaseSuffixRule }]
            - call: [<.rules.push, lowercase_suffix_rule]
            - decl: [long_long_rule, ptr<Rule>, { new: LongLongSuffixRule }]
            - call: [<.rules.push, long_long_rule]
            - decl: [braced_bodies, ptr<Rule>, { new: BracedBodiesRule }]
            - call: [<.rules.push, braced_bodies]
            - decl: [null_alone, ptr<Rule>, { new: NullStatementAloneRule }]
            - call: [<.rules.push, null_alone]
            - decl: [explicit_ctor, ptr<Rule>, { new: ExplicitSingleArgConstructorRule }]
            - call: [<.rules.push, explicit_ctor]
            - decl: [c_style_cast_rule, ptr<Rule>, { new: NoCStyleCastRule }]
            - call: [<.rules.push, c_style_cast_rule]
            - decl: [float_equality, ptr<Rule>, { new: NoFloatEqualityRule }]
            - call: [<.rules.push, float_equality]
            - decl: [symmetric_operator, ptr<Rule>, { new: SymmetricOperatorNonMemberRule }]
            - call: [<.rules.push, symmetric_operator]
            - decl: [spliced_macro, ptr<Rule>, { new: NoSplicedMacroRule }]
            - call: [<.rules.push, spliced_macro]
            - decl: [reserved_macro, ptr<Rule>, { new: NoReservedMacroRule }]
            - call: [<.rules.push, reserved_macro]
            - decl: [no_varargs, ptr<Rule>, { new: NoVarargsRule }]
            - call: [<.rules.push, no_varargs]
            - decl: [function_length, ptr<Rule>, { new: FunctionLengthRule }]
            - call: [<.rules.push, function_length]
            - decl: [cyclomatic, ptr<Rule>, { new: CyclomaticComplexityRule }]
            - call: [<.rules.push, cyclomatic]
            - decl: [nesting, ptr<Rule>, { new: NestingDepthRule }]
            - call: [<.rules.push, nesting]
            - decl: [code_lines, ptr<Rule>, { new: FileCodeLinesRule }]
            - call: [<.rules.push, code_lines]
            - decl: [comment_density, ptr<Rule>, { new: CommentDensityRule }]
            - call: [<.rules.push, comment_density]
            - decl: [token_count, ptr<Rule>, { new: FunctionTokenCountRule }]
            - call: [<.rules.push, token_count]
            - decl: [loop_exit, ptr<Rule>, { new: SingleLoopExitRule }]
            - call: [<.rules.push, loop_exit]
            - decl: [single_exit, ptr<Rule>, { new: SingleExitRule }]
            - call: [<.rules.push, single_exit]
            - decl: [static_param, ptr<Rule>, { new: NoStaticArrayParamRule }]
            - call: [<.rules.push, static_param]
            - decl: [sizeof_param, ptr<Rule>, { new: NoSizeofArrayParamRule }]
            - call: [<.rules.push, sizeof_param]
            - decl: [typeid_poly, ptr<Rule>, { new: NoTypeidPolymorphicRule }]
            - call: [<.rules.push, typeid_poly]
            - decl: [delete_incomplete, ptr<Rule>, { new: NoDeleteIncompleteRule }]
            - call: [<.rules.push, delete_incomplete]
            - decl: [assignment_result, ptr<Rule>, { new: NoAssignmentResultRule }]
            - call: [<.rules.push, assignment_result]
            - decl: [param_change, ptr<Rule>, { new: NoParameterModificationRule }]
            - call: [<.rules.push, param_change]
            - decl: [sole_init_list, ptr<Rule>, { new: SoleInitListConstructorRule }]
            - call: [<.rules.push, sole_init_list]
            - decl: [zero_align, ptr<Rule>, { new: NoZeroAlignmentRule }]
            - call: [<.rules.push, zero_align]
            - decl: [single_align, ptr<Rule>, { new: SingleAlignmentSpecifierRule }]
            - call: [<.rules.push, single_align]
            - decl: [generic_default_only, ptr<Rule>, { new: GenericNonDefaultRule }]
            - call: [<.rules.push, generic_default_only]
            - decl: [generic_default_pos, ptr<Rule>, { new: GenericDefaultPositionRule }]
            - call: [<.rules.push, generic_default_pos]
            - decl: [prototypes, ptr<Rule>, { new: PrototypeWithNamesRule }]
            - call: [<.rules.push, prototypes]
            - decl: [no_vla, ptr<Rule>, { new: NoVariableLengthArrayRule }]
            - call: [<.rules.push, no_vla]
            - decl: [no_vla_pointer, ptr<Rule>, { new: NoPointerToVlaRule }]
            - call: [<.rules.push, no_vla_pointer]
            - decl: [sizeof_effect, ptr<Rule>, { new: NoSideEffectInSizeofRule }]
            - call: [<.rules.push, sizeof_effect]
            - decl: [pointer_arith, ptr<Rule>, { new: NoPointerArithOperatorsRule }]
            - call: [<.rules.push, pointer_arith]
            - decl: [range_calls, ptr<Rule>, { new: SimpleRangeInitializerRule }]
            - call: [<.rules.push, range_calls]
      - def:
          name: rule_count
          args: []
          return: i32
          body:
            - return: <.rules.len
