# OC-0185 no_zero_alignment and OC-0186 single_alignment_specifier (catalogue in
# Pymann/coding-rules), C11.  Read from RuleInformation: the alignas specifiers
# written on each object declaration.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"

- def:
    name: object_decl
    args: [[rec, ref<IrDecl>]]
    return: bool
    body:
      - return: { "&&": [{ call: [user_decl, rec] }, { eq: [{ call: [regex.search, "^(Var|Field)$", rec.kind] }, 0] }] }

- class:
    name: NoZeroAlignmentRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 185, "safety.c11-.6.8.no_zero_alignment", "Objects are not declared with alignment zero", "error", "c"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.decls.len] }
                body:
                  - decl: [rec, ref<IrDecl>, { at: [info.decls, idx] }]
                  - if:
                      condition: { "&&": [{ call: [object_decl, rec] }, { gte: [rec.zero_align_pos.file_uid, 0] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.zero_align_pos, 185, "the alignment of '${rec.name}' is zero, which has no effect; give the alignment you mean or remove the specifier"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: SingleAlignmentSpecifierRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 186, "style.c11-.6.8.single_alignment_specifier", "An object declaration has at most one alignment specifier", "warn", "c"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.decls.len] }
                body:
                  - decl: [rec, ref<IrDecl>, { at: [info.decls, idx] }]
                  - if:
                      condition: { "&&": [{ call: [object_decl, rec] }, { gt: [rec.align_count, 1] }, { gte: [rec.second_align_pos.file_uid, 0] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.second_align_pos, 186, "'${rec.name}' has ${rec.align_count} alignment specifiers; the strictest wins, keep only that one"] }]
                  - set: [idx, { "+": [idx, 1] }]
