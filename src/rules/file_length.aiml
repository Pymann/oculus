# Threshold rule on a metric: OC-0380 file_length of the catalogue in Pymann/coding-rules.
# Until the catalogue is loaded, its attributes are repeated here.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"

- class:
    name: FileLengthRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - decl: [info, RuleSpec]
            - set: [info.rule_id, 380]
            - set: [info.rule_key, "metric.c90-.19.1.file_length"]
            - set: [info.title, "A source file does not exceed the configured number of lines"]
            - set: [info.category, "metric"]
            - set: [info.subcategory, "19.1"]
            - set: [info.severity, "warn"]
            - call: [info.languages.push, "c"]
            - call: [info.languages.push, "c++"]
            - return: info
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [limit, i32, setting.limit]
            - if: { condition: { lte: [limit, 0] }, then: [{ set: [limit, 1000] }] }
            - decl: [total, i32, { call: [metrics.get, "lines.total", 0] }]
            - if:
                condition: { gt: [total, limit] }
                then:
                  - decl: [hit, Finding]
                  - set: [hit.file_name, unit.file_name]
                  - set: [hit.line, { "+": [limit, 1] }]
                  - set: [hit.column, 1]
                  - set: [hit.rule_id, 380]
                  - set: [hit.message, "file has ${total} lines, more than the limit of ${limit}"]
                  - call: [out.push, hit]
