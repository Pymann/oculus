# OC-0374 no_setlocale (catalogue in Pymann/coding-rules).  Read from
# RuleInformation: references to setlocale and std::locale::global with the call
# around them, and the string literals among that call's arguments.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"
- import: "src/rules/library_calls.aiml"

# The nodes with a string literal directly among their children, by uid.
- def:
    name: literal_parents
    args: [[info, RuleInformation]]
    return: map<string:i32>
    body:
      - decl: [found, map<string:i32>]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, info.nodes.len] }
          body:
            - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
            - if: { condition: { eq: [{ call: [regex.search, "^StringLiteral$", rec.kind] }, 0] }, then: [{ call: [found.set, "${rec.parent_uid}", 1] }] }
            - set: [idx, { "+": [idx, 1] }]
      - return: found

# setlocale called with a locale name written as a string: it changes the locale.
# A NULL argument only asks for the current one; a name in a variable is not
# known here and is left out.
- def:
    name: setlocale_change
    args: [[info, RuleInformation], [literals, map<string:i32>], [rec, ref<IrNode>]]
    return: bool
    body:
      - if: { condition: { eq: [{ call: [library_function, info, rec, "^setlocale$", "^setlocale$"] }, false] }, then: [{ return: false }] }
      - if: { condition: { eq: [{ call: [info_has_node, info, rec.parent_uid] }, false] }, then: [{ return: false }] }
      - decl: [call, ref<IrNode>, { at: [info.nodes, rec.parent_uid] }]
      - if: { condition: { neq: [{ call: [regex.search, "^CallExpr$", call.kind] }, 0] }, then: [{ return: false }] }
      - return: { eq: [{ call: [literals.get, "${call.uid}", 0] }, 1] }

# A reference to std::locale::global.
- def:
    name: global_locale
    args: [[info, RuleInformation], [rec, ref<IrNode>]]
    return: bool
    body:
      - if: { condition: { neq: [{ call: [regex.search, "^(DeclRefExpr|MemberExpr)$", rec.kind] }, 0] }, then: [{ return: false }] }
      - if: { condition: { eq: [{ call: [info_has_decl, info, rec.ref_uid] }, false] }, then: [{ return: false }] }
      - decl: [callee, ref<IrDecl>, { at: [info.decls, rec.ref_uid] }]
      - if: { condition: { "||": [{ neq: [{ call: [regex.search, "^CXXMethod$", callee.kind] }, 0] }, { neq: [{ call: [regex.search, "^global$", callee.name] }, 0] }, { eq: [callee.origin.in_system_header, false] }] }, then: [{ return: false }] }
      - if: { condition: { eq: [{ call: [info_has_decl, info, callee.parent_uid] }, false] }, then: [{ return: false }] }
      - decl: [owner, ref<IrDecl>, { at: [info.decls, callee.parent_uid] }]
      - if: { condition: { neq: [{ call: [regex.search, "^locale$", owner.name] }, 0] }, then: [{ return: false }] }
      - if: { condition: { eq: [{ call: [info_has_decl, info, owner.parent_uid] }, false] }, then: [{ return: false }] }
      - decl: [space, ref<IrDecl>, { at: [info.decls, owner.parent_uid] }]
      - return: { eq: [{ call: [regex.search, "^std$", space.name] }, 0] }

- class:
    name: NoSetlocaleRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 374, "safety.c90-.13.3.no_setlocale", "The global locale is not changed", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [literals, map<string:i32>, { call: [literal_parents, info] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_node, rec] }, { "||": [{ call: [setlocale_change, info, literals, rec] }, { call: [global_locale, info, rec] }] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 374, "the global locale is changed here, for every thread and library call; pass a locale object to the code that needs it"] }]
                  - set: [idx, { "+": [idx, 1] }]
