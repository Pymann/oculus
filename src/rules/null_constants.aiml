# OC-0337 nullptr_only and OC-0250 no_null_as_integer (catalogue in
# Pymann/coding-rules), C++.  Read from IrNode.shape of 0 and NULL (the first
# implicit conversion above them): null_pointer, null_integer.  NULL comes from
# a system header, so the place is the expansion in the user's file; a null
# pointer constant in an extern "C" function is not reported for OC-0337.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"
- import: "src/rules/library_macros.aiml"

# Is the node in a function declared extern "C"?
- def:
    name: in_extern_c_function
    args: [[info, RuleInformation], [rec, ref<IrNode>]]
    return: bool
    body:
      - if: { condition: { eq: [{ call: [info_has_decl, info, rec.function_uid] }, false] }, then: [{ return: false }] }
      - decl: [owner, ref<IrDecl>, { at: [info.decls, rec.function_uid] }]
      - return: owner.in_extern_c

- class:
    name: NullptrOnlyRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 337, "safety.cpp11-.8.3.nullptr_only", "nullptr is the only null pointer constant", "error", "c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ gte: [{ call: [regex.search, "(^|,)null_pointer(,|$)", rec.shape] }, 0] }, { call: [expanded_in_user_file, info, rec.pos.expansion] }, { eq: [{ call: [in_extern_c_function, info, rec] }, false] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.pos.expansion, 337, "null pointer written as 0 or NULL; write nullptr"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: NoNullAsIntegerRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 250, "safety.cpp98-.8.3.no_null_as_integer", "NULL is not used as an integer value", "error", "c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ gte: [{ call: [regex.search, "(^|,)null_integer(,|$)", rec.shape] }, 0] }, { call: [expanded_in_user_file, info, rec.pos.expansion] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.pos.expansion, 250, "NULL is used as an integer; write 0 (or nullptr for a pointer)"] }]
                  - set: [idx, { "+": [idx, 1] }]
