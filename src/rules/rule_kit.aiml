# Shared pieces of the rules: the spec from the catalogue attributes, where a
# finding goes, and which records count as the user's code.
#
# The common filter for "the user's code": not in a system header, not implicit
# (written by nobody), not a template instantiation (rules on declarations and
# syntax report the template itself, once).  A node spelled in a system header
# comes from a system macro and is not the user's either.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"

# The attributes of a catalogue rule (Pymann/coding-rules, catalog.json).  The key
# is `<category>.<lang><from>-<to>.<chapter>.<sub>.<shortname>`; `languages` is a
# comma list of "c" and "c++".
- def:
    name: rule_spec
    args: [[rule_id, i32], [rule_key, string], [title, string], [severity, string], [languages, string]]
    return: RuleSpec
    body:
      - decl: [info, RuleSpec]
      - set: [info.rule_id, rule_id]
      - set: [info.rule_key, rule_key]
      - set: [info.title, title]
      - set: [info.severity, severity]
      - decl: [parts, list<string>, { call: [rule_key.split, "."] }]
      - if:
          condition: { gte: [parts.len, 4] }
          then:
            - set: [info.category, { at: [parts, 0] }]
            - decl: [chapter, string, { at: [parts, 2] }]
            - decl: [section, string, { at: [parts, 3] }]
            - set: [info.subcategory, "${chapter}.${section}"]
      - set: [info.languages, { call: [languages.split, ","] }]
      - if:
          condition: { gte: [parts.len, 2] }
          then:
            - decl: [range, string, { at: [parts, 1] }]
            - decl: [ends, list<string>, { call: [range.split, "-"] }]
            - decl: [years, map<string:i32>, { c90: 1990, c99: 1999, c11: 2011, c17: 2017, c23: 2023, cpp98: 1998, cpp03: 2003, cpp11: 2011, cpp14: 2014, cpp17: 2017, cpp20: 2020, cpp23: 2023 }]
            - set: [info.from_year, { call: [years.get, { at: [ends, 0] }, 0] }]
      - return: info

# The year of a unit's language standard as the frontend names it (c99, gnu11,
# c++17, gnu++2a ...); 0 when unknown.
- def:
    name: standard_year
    args: [[standard, string]]
    return: i32
    body:
      - decl: [years, map<string:i32>, { c89: 1990, c90: 1990, gnu89: 1990, iso9899_199409: 1994, c94: 1994, c99: 1999, gnu99: 1999, c11: 2011, gnu11: 2011, c17: 2017, gnu17: 2017, c18: 2017, gnu18: 2017, c2x: 2023, gnu2x: 2023, c23: 2023, gnu23: 2023 }]
      - decl: [cxx_years, map<string:i32>, { "c++98": 1998, "gnu++98": 1998, "c++03": 2003, "gnu++03": 2003, "c++11": 2011, "gnu++11": 2011, "c++14": 2014, "gnu++14": 2014, "c++17": 2017, "gnu++17": 2017, "c++20": 2020, "gnu++20": 2020, "c++2a": 2020, "gnu++2a": 2020, "c++23": 2023, "gnu++23": 2023, "c++2b": 2023, "gnu++2b": 2023, "c++26": 2026, "gnu++26": 2026, "c++2c": 2026, "gnu++2c": 2026 }]
      - if: { condition: { call: [cxx_years.has, standard] }, then: [{ return: { call: [cxx_years.get, standard, 0] } }] }
      - return: { call: [years.get, standard, 0] }

# The file of a finding as the user named it: the unit's own name for the main
# file, otherwise the frontend's path, relative to the compile command's directory.
- def:
    name: finding_file
    args: [[unit, IrUnit], [file_uid, i32]]
    return: string
    body:
      - if:
          condition: { "&&": [{ gte: [file_uid, 0] }, { lt: [file_uid, unit.info.files.len] }] }
          then:
            - decl: [file, ref<IrFile>, { at: [unit.info.files, file_uid] }]
            - if: { condition: file.is_main, then: [{ return: unit.file_name }] }
            - if: { condition: { call: [file.path.starts_with, "/"] }, then: [{ return: file.path }] }
            - decl: [plain, bool, { "||": [{ eq: [unit.directory.len, 0] }, { eq: [unit.directory, "."] }] }]
            - if: { condition: plain, then: [{ return: file.path }] }
            - return: "${unit.directory}/${file.path}"
      - return: unit.file_name

- def:
    name: pos_finding
    args: [[unit, IrUnit], [pos, IrPos], [rule_id, i32], [message, string]]
    return: Finding
    body:
      - decl: [hit, Finding]
      - set: [hit.file_name, { call: [finding_file, unit, pos.file_uid] }]
      - set: [hit.line, pos.line]
      - set: [hit.column, pos.column]
      - set: [hit.rule_id, rule_id]
      - set: [hit.message, message]
      - return: hit

# Written by the user in this place: not a system header, not implicit, not an
# instantiation of a template.
- def:
    name: user_decl
    args: [[decl, ref<IrDecl>]]
    return: bool
    body:
      - if: { condition: decl.origin.in_system_header, then: [{ return: false }] }
      - if: { condition: decl.origin.implicit, then: [{ return: false }] }
      - if: { condition: decl.origin.instantiated, then: [{ return: false }] }
      - if: { condition: decl.in_instantiation, then: [{ return: false }] }
      - return: true

# The node is the user's: not spelled in a system header (a system macro).
- def:
    name: user_node
    args: [[node, ref<IrNode>]]
    return: bool
    body:
      - return: { eq: [node.in_system_header, false] }

# The tag of the declaration `parent_uid` ("" if there is none).
- def:
    name: parent_tag
    args: [[info, RuleInformation], [parent_uid, i32]]
    return: string
    body:
      - if: { condition: { eq: [{ call: [info_has_decl, info, parent_uid] }, false] }, then: [{ return: "" }] }
      - decl: [parent, ref<IrDecl>, { at: [info.decls, parent_uid] }]
      - return: parent.tag

- def:
    name: info_has_node
    args: [[info, RuleInformation], [node_uid, i32]]
    return: bool
    body:
      - return: { "&&": [{ gte: [node_uid, 0] }, { lt: [node_uid, info.nodes.len] }] }
