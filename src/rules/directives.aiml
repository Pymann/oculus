# OC-0363 no_pragma, OC-0319 include_guards and OC-0317 defined_standard_form
# (catalogue in Pymann/coding-rules).  OC-0317 reads the condition records of
# `macros` (a #if or #elif using a macro that expands to `defined`).
# Read from RuleInformation: the pragma records of `macros` (the text of the
# directive), and for every header the frontend's include-guard verdict: Clang's
# multiple-include optimisation recognises `#ifndef X` / `#define X` / ... `#endif`
# around the whole content (comments aside) and `#pragma once`; the frontend also
# accepts several guarded blocks in a row and headers of directives only.  A header
# included inside a declaration is a data or X-macro file and is not judged.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"

- def:
    name: pragma_once
    args: [[rec, ref<IrMacro>]]
    return: bool
    body:
      - return: { eq: [{ call: [regex.search, "^(#[ \\t]*pragma[ \\t]+once\\b|_Pragma[ \\t]*\\([ \\t]*\"once\")", rec.body] }, 0] }

- class:
    name: NoPragmaRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 363, "style.c90-.12.2.no_pragma", "#pragma and _Pragma are not used", "warn", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.macros.len] }
                body:
                  - decl: [rec, ref<IrMacro>, { at: [info.macros, idx] }]
                  - if:
                      condition: { "&&": [{ eq: [{ call: [regex.search, "^pragma$", rec.kind] }, 0] }, { eq: [{ call: [pragma_once, rec] }, false] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.pos, 363, "a pragma is used; its meaning depends on the compiler"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: IncludeGuardsRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 319, "safety.c90-.12.1.include_guards", "Every header is protected against repeated inclusion", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.files.len] }
                body:
                  - decl: [file, ref<IrFile>, { at: [info.files, idx] }]
                  - if:
                      condition: { "&&": [{ eq: [{ call: [regex.search, "^header$", file.kind] }, 0] }, { eq: [file.include_guarded, false] }, { eq: [file.included_in_declaration, false] }, { gt: [file.first_line, 0] }, { call: [header_name, file.path] }] }
                      then:
                        - decl: [pos, IrPos]
                        - set: [pos.file_uid, file.uid]
                        - set: [pos.line, file.first_line]
                        - set: [pos.column, file.first_column]
                        - call: [out.push, { call: [pos_finding, unit, pos, 319, "this header has no include guard (#ifndef/#define/#endif around all of it, or #pragma once)"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: DefinedStandardFormRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 317, "safety.c90-.12.3.defined_standard_form", "The defined operator is used only as defined(X) or defined X", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.macros.len] }
                body:
                  - decl: [rec, ref<IrMacro>, { at: [info.macros, idx] }]
                  - if:
                      condition: { eq: [{ call: [regex.search, "^condition$", rec.kind] }, 0] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.pos, 317, "the condition uses '${rec.name}', which expands to defined; write defined(NAME) in the directive itself"] }]
                  - set: [idx, { "+": [idx, 1] }]
