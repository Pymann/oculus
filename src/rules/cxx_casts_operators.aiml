# OC-0254 no_c_style_cast, OC-0257 no_float_equality and OC-0359
# symmetric_operator_non_member (catalogue in Pymann/coding-rules), C++.  Read
# from RuleInformation: cast nodes with their target type and the function around
# them, == and != with the types of their operands, member operators with their
# parameters, storage and defaulted flag.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"
- import: "src/rules/library_cxx.aiml"
- import: "src/rules/cxx_scope.aiml"

- def:
    name: floating_type
    args: [[info, RuleInformation], [type_uid, i32]]
    return: bool
    body:
      - decl: [canon_uid, i32, { call: [canonical_of, info, type_uid] }]
      - if: { condition: { lt: [canon_uid, 0] }, then: [{ return: false }] }
      - decl: [canon, ref<IrType>, { at: [info.types, canon_uid] }]
      - return: { "&&": [canon.is_builtin, { eq: [{ call: [regex.search, "^(float|double|long double|_Float16|_Float32|_Float64|_Float128|__fp16|__bf16|__float128|__ibm128)$", canon.name] }, 0] }] }

- def:
    name: record_type
    args: [[info, RuleInformation], [type_uid, i32]]
    return: bool
    body:
      - decl: [canon_uid, i32, { call: [canonical_of, info, type_uid] }]
      - if: { condition: { lt: [canon_uid, 0] }, then: [{ return: false }] }
      - decl: [canon, ref<IrType>, { at: [info.types, canon_uid] }]
      - return: { "||": [canon.is_record, canon.is_dependent] }

# A C-style cast, or a functional cast to a type that is not a class (that one is
# a constructor call); a cast to void discards a value.  Code in an extern "C"
# function is C and has no other cast.
- def:
    name: c_style_cast
    args: [[info, RuleInformation], [rec, ref<IrNode>]]
    return: bool
    body:
      - if: { condition: { neq: [{ call: [regex.search, "^(CStyleCastExpr|CXXFunctionalCastExpr)$", rec.kind] }, 0] }, then: [{ return: false }] }
      - if: { condition: { call: [void_type, info, rec.type_uid] }, then: [{ return: false }] }
      - if: { condition: { "&&": [{ eq: [{ call: [regex.search, "^CXXFunctionalCastExpr$", rec.kind] }, 0] }, { call: [record_type, info, rec.type_uid] }] }, then: [{ return: false }] }
      # written in a macro body: the macro may come from a C header that a C++ file
      # includes, where no other cast exists
      - if: { condition: { "&&": [rec.pos.from_macro, { neq: [rec.pos.spelling.file_uid, -1] }, { "||": [{ neq: [rec.pos.spelling.file_uid, rec.pos.expansion.file_uid] }, { neq: [rec.pos.spelling.line, rec.pos.expansion.line] }] }] }, then: [{ return: false }] }
      - return: { call: [cxx_only_call, info, rec] }

# The == and != nodes with an operand of floating type, by uid.
- def:
    name: float_comparisons
    args: [[info, RuleInformation]]
    return: map<string:i32>
    body:
      - decl: [found, map<string:i32>]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, info.nodes.len] }
          body:
            - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
            - if:
                condition: { "&&": [{ call: [info_has_node, info, rec.parent_uid] }, { eq: [rec.is_dependent, false] }, { call: [floating_type, info, rec.type_uid] }] }
                then:
                  - decl: [owner, ref<IrNode>, { at: [info.nodes, rec.parent_uid] }]
                  - if:
                      condition: { "&&": [{ eq: [{ call: [regex.search, "^BinaryOperator$", owner.kind] }, 0] }, { eq: [{ call: [regex.search, "^(==|!=)$", owner.detail] }, 0] }, { eq: [owner.is_dependent, false] }] }
                      then: [{ call: [found.set, "${owner.uid}", 1] }]
            - set: [idx, { "+": [idx, 1] }]
      - return: found

# A binary arithmetic, bitwise or comparison operator as a non-static member.
# Shifts are left out (stream insertion), && and || are OC-0358, a defaulted ==
# or <=> gets its reversed form from the compiler.
- def:
    name: member_symmetric_operator
    args: [[rec, ref<IrDecl>]]
    return: bool
    body:
      - if: { condition: { neq: [{ call: [regex.search, "^CXXMethod$", rec.kind] }, 0] }, then: [{ return: false }] }
      - if: { condition: { "||": [{ neq: [rec.param_count, 1] }, rec.is_defaulted, { eq: [rec.is_first_decl, false] }, { eq: [{ call: [regex.search, "^static$", rec.storage] }, 0] }] }, then: [{ return: false }] }
      - return: { eq: [{ call: [regex.search, "^operator(\\+|-|\\*|/|%|\\^|&|\\||==|!=|<|>|<=|>=|<=>)$", rec.name] }, 0] }

- class:
    name: NoCStyleCastRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 254, "safety.cpp98-.8.2.no_c_style_cast", "C-style and functional casts are not used", "error", "c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_node, rec] }, { call: [c_style_cast, info, rec] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 254, "this is a C-style or functional cast; use static_cast, const_cast or reinterpret_cast"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: NoFloatEqualityRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 257, "safety.cpp98-.9.2.no_float_equality", "Floating-point values are not compared with == or !=", "error", "c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [compared, map<string:i32>, { call: [float_comparisons, info] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_node, rec] }, { eq: [{ call: [compared.get, "${rec.uid}", 0] }, 1] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 257, "floating-point values are compared with == or !=; compare with a tolerance"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: SymmetricOperatorNonMemberRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 359, "style.cpp98-.15.4.symmetric_operator_non_member", "Symmetric operators are non-member functions", "warn", "c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.decls.len] }
                body:
                  - decl: [rec, ref<IrDecl>, { at: [info.decls, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_decl, rec] }, { call: [member_symmetric_operator, rec] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.name_pos, 359, "${rec.name} is a member, so only its right operand converts; make it a non-member (friend) function"] }]
                  - set: [idx, { "+": [idx, 1] }]
