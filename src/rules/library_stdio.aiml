# OC-0166 no_fenv, OC-0167 no_stdio and OC-0120 no_varargs (catalogue in
# Pymann/coding-rules).  Read from RuleInformation: the #include records (fenv.h),
# references to the functions of stdio.h (library check of library_calls.aiml), and
# declared types with their typedef chain (va_list).

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"
- import: "src/rules/library_calls.aiml"

- class:
    name: NoFenvRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 166, "safety.c99-.13.2.no_fenv", "fenv.h and its exception handling are not used", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.macros.len] }
                body:
                  - decl: [rec, ref<IrMacro>, { at: [info.macros, idx] }]
                  - if:
                      condition: { "&&": [{ eq: [{ call: [regex.search, "^include$", rec.kind] }, 0] }, { eq: [{ call: [regex.search, "^(fenv\\.h|cfenv)$", rec.name] }, 0] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, rec.pos, 166, "fenv.h is included; the floating-point environment is not changed"] }]
                  - set: [idx, { "+": [idx, 1] }]

- class:
    name: NoStdioRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 167, "safety.c90-.13.3.no_stdio", "The standard input/output functions are not used", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.nodes.len] }
                body:
                  - decl: [rec, ref<IrNode>, { at: [info.nodes, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_node, rec] }, { call: [library_function, info, rec, "^(printf|fprintf|sprintf|snprintf|vprintf|vfprintf|vsprintf|vsnprintf|scanf|fscanf|sscanf|vscanf|vfscanf|vsscanf|fopen|freopen|fclose|fflush|setbuf|setvbuf|fread|fwrite|fgetc|getc|getchar|fgets|gets|fputc|putc|putchar|fputs|puts|ungetc|fseek|ftell|rewind|fgetpos|fsetpos|clearerr|feof|ferror|perror|remove|rename|tmpfile|tmpnam)$", "^(printf|fprintf|sprintf|snprintf|vprintf|vfprintf|vsprintf|vsnprintf|scanf|fscanf|sscanf|vscanf|vfscanf|vsscanf|fopen|freopen|fclose|fflush|setbuf|setvbuf|fread|fwrite|fgetc|getc|getchar|fgets|gets|fputc|putc|putchar|fputs|puts|ungetc|fseek|ftell|rewind|fgetpos|fsetpos|clearerr|feof|ferror|perror|remove|rename|tmpfile|tmpnam)$"] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 167, { call: [library_message, info, rec, "the input/output functions of stdio.h are not used; use the project's I/O layer"] }] }]
                  - set: [idx, { "+": [idx, 1] }]

# A type that is va_list, through its typedefs.
- def:
    name: va_list_type
    args: [[info, RuleInformation], [type_uid, i32]]
    return: bool
    body:
      - decl: [cursor, i32, type_uid]
      - decl: [steps, i32, 0]
      - while:
          condition: { "&&": [{ call: [info_has_type, info, cursor] }, { lt: [steps, 32] }] }
          body:
            - decl: [step, ref<IrType>, { at: [info.types, cursor] }]
            - if: { condition: { gte: [{ call: [regex.search, "(^|::)(va_list|__gnuc_va_list|__builtin_va_list)$", step.name] }, 0] }, then: [{ return: true }] }
            - set: [cursor, step.sugar_uid]
            - set: [steps, { "+": [steps, 1] }]
      - return: false

- class:
    name: NoVarargsRule
    implements: [Rule]
    methods:
      - def:
          name: spec
          args: []
          return: RuleSpec
          body:
            - return: { call: [rule_spec, 120, "safety.c90-.11.1.no_varargs", "Variable argument lists from stdarg are not used", "error", "c,c++"] }
      - def:
          name: check_unit
          args: [[unit, IrUnit], [metrics, map<string:i32>], [setting, RuleSetting], [out, list<Finding>]]
          return: void
          body:
            - decl: [info, RuleInformation, unit.info]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, info.decls.len] }
                body:
                  - decl: [rec, ref<IrDecl>, { at: [info.decls, idx] }]
                  - if:
                      condition: { "&&": [{ call: [user_decl, rec] }, { eq: [{ call: [regex.search, "^(Var|ParmVar|Field)$", rec.kind] }, 0] }, { call: [va_list_type, info, rec.type_uid] }] }
                      then:
                        - call: [out.push, { call: [pos_finding, unit, { call: [written_pos, rec.pos] }, 120, "${rec.name} is a va_list; stdarg.h is not used, pass the arguments with their types"] }]
                  - set: [idx, { "+": [idx, 1] }]
