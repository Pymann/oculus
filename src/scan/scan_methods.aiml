# The scan itself, as a method of the `scanner` instance of ScanRuntime.
#
# Per translation unit: frontend -> IR -> metrics -> every enabled rule.  The
# units run one after another in this process for now; the worker processes of
# doc/architecture.md section 3 replace this loop, the per-unit step stays.

- import: "src/ir/ir.aiml"
- import: "src/report/finding.aiml"
- import: "src/rules/rule.aiml"
- import: "src/rules/rule_kit.aiml"
- import: "src/config/options.aiml"
- import: "src/scan/compile_db.aiml"
- import: "src/scan/planner.aiml"

- groupmethods:
    group: ScanRuntime
    instances:
      - instance: scanner
        methods:
          - def:
              name: scan_units
              args: [[commands, list<CompileCommand>], [opts, ScanOptions]]
              return: list<Finding>
              body:
                - decl: [found, list<Finding>]
                - set: [<.planned_workers, { call: [worker_count, opts.jobs, commands.len, 1500] }]
                - decl: [idx, i32, 0]
                - while:
                    condition: { lt: [idx, commands.len] }
                    body:
                      - decl: [cmd, CompileCommand, { at: [commands, idx] }]
                      - decl: [unit, IrUnit, { call: [<.frontend.parse_unit, cmd] }]
                      - if:
                          condition: { gt: [unit.info.problem.len, 0] }
                          then: [{ call: [<.unit_problems.push, unit.info.problem] }]
                      - decl: [fix, i32, 0]
                      - while:
                          condition: { lt: [fix, unit.info.dropped_flags.len] }
                          body:
                            - decl: [flag, string, { at: [unit.info.dropped_flags, fix] }]
                            - if: { condition: { eq: [{ call: [<.dropped_flags.contains, flag] }, false] }, then: [{ call: [<.dropped_flags.push, flag] }] }
                            - set: [fix, { "+": [fix, 1] }]
                      - if:
                          condition: { gt: [unit.info.compile_errors, 0] }
                          then: [{ call: [<.unclean_units.push, "${unit.file_name}: ${unit.info.compile_errors} compile error(s), first: ${unit.info.first_error}"] }]
                      # A unit Clang could not compile cleanly gets no findings at all: the
                      # rules would see a partial AST (missing includes or defines turn
                      # types into errors), and a broken parse must never produce findings.
                      - if:
                          condition: { eq: [unit.info.compile_errors, 0] }
                          then:
                            - decl: [metrics, map<string:i32>]
                            - call: [<.line_metric.measure, unit, metrics]
                            - call: [<.check_rules, unit, metrics, opts, found]
                      - call: [<.count_unit]
                      - set: [idx, { "+": [idx, 1] }]
                - return: found

          - def:
              name: check_rules
              args: [[unit, IrUnit], [metrics, map<string:i32>], [opts, ScanOptions], [found, list<Finding>]]
              return: void
              body:
                - decl: [floor, i32, { call: [severity_rank, opts.threshold] }]
                - decl: [rix, i32, 0]
                - while:
                    condition: { lt: [rix, <.registry.rules.len] }
                    body:
                      - decl: [rule, ref<Rule>, { at: [<.registry.rules, rix] }]
                      - decl: [info, RuleSpec, { call: [rule.spec] }]
                      - decl: [setting, RuleSetting]
                      - set: [setting.enabled, info.on_by_default]
                      - decl: [six, i32, 0]
                      - while:
                          condition: { lt: [six, opts.rules.len] }
                          body:
                            - decl: [entry, RuleSetting, { at: [opts.rules, six] }]
                            - if: { condition: { eq: [entry.rule, info.rule_id] }, then: [{ set: [setting, entry] }] }
                            - set: [six, { "+": [six, 1] }]
                      - decl: [wanted, bool, setting.enabled]
                      # a rule runs only on the languages it is written for
                      - decl: [lang, string, unit.info.language]
                      - if: { condition: { eq: [lang.len, 0] }, then: [{ set: [lang, unit.language] }] }
                      - decl: [speaks, bool, { call: [info.languages.contains, lang] }]
                      # ... and from the standard it is written for (an `enum class` rule
                      # does not apply to C++98)
                      - decl: [unit_year, i32, { call: [standard_year, unit.info.standard] }]
                      - if: { condition: { "&&": [{ gt: [unit_year, 0] }, { lt: [unit_year, info.from_year] }] }, then: [{ set: [speaks, false] }] }
                      - decl: [c_too, bool, { call: [info.languages.contains, "c"] }]
                      - if:
                          condition: { gt: [opts.single_rule, 0] }
                          then:
                            - set: [wanted, { eq: [info.rule_id, opts.single_rule] }]
                      - if:
                          condition: { "&&": [wanted, speaks] }
                          then:
                            - decl: [sev, string, setting.severity]
                            - if: { condition: { eq: [sev.len, 0] }, then: [{ set: [sev, info.severity] }] }
                            - decl: [hits, list<Finding>]
                            - call: [rule.check_unit, unit, metrics, setting, hits]
                            - if:
                                condition: { gte: [{ call: [severity_rank, sev] }, floor] }
                                then:
                                  - decl: [hix, i32, 0]
                                  - while:
                                      condition: { lt: [hix, hits.len] }
                                      body:
                                        - decl: [hit, Finding, { at: [hits, hix] }]
                                        - set: [hit.severity, sev]
                                        # a C++-only rule does not judge a C source a C++
                                        # unit includes (C code compiled for compatibility)
                                        - decl: [c_file, bool, { gte: [{ call: [regex.search, "\\.c$", hit.file_name] }, 0] }]
                                        - if: { condition: { "&&": [c_file, { eq: [c_too, false] }] }, then: [{ set: [hit.rule_id, 0] }] }
                                        - decl: [where, string, "${hit.file_name}:${hit.line}:${hit.column}:${hit.rule_id}"]
                                        - if:
                                            condition: { "&&": [{ gt: [hit.rule_id, 0] }, { eq: [{ call: [<.reported.has, where] }, 0] }] }
                                            then:
                                              - call: [<.reported.set, where, 1]
                                              - call: [found.push, hit]
                                        - set: [hix, { "+": [hix, 1] }]
                      - set: [rix, { "+": [rix, 1] }]
