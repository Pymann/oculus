# How many translation units may be worked on at once: no more than --jobs (or the
# CPUs), no more than the free RAM allows at the expected peak per unit, no more
# than there are units, and at least one.

# MemAvailable from /proc/meminfo in MiB; 0 if it cannot be read.
- def:
    name: available_mib
    args: []
    return: i32
    body:
      - decl: [info_path, path, { call: [path.from_string, "/proc/meminfo"] }]
      - if: { condition: { eq: [{ call: [io.is_file, info_path] }, false] }, then: [{ return: 0 }] }
      - decl: [text, string, { call: [io.read_file, info_path] }]
      - decl: [rows, list<string>, { call: [text.split, "\n"] }]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, rows.len] }
          body:
            - decl: [row, string, { at: [rows, idx] }]
            - if:
                condition: { call: [row.starts_with, "MemAvailable:"] }
                then:
                  - decl: [rest, string, { call: [row.substr, 13] }]
                  - decl: [trimmed, string, { call: [rest.trim] }]
                  - decl: [parts, list<string>, { call: [trimmed.split, " "] }]
                  - decl: [first, string, { at: [parts, 0] }]
                  - decl: [kib, i32, { call: [first.parse_i32] }]
                  - return: { "/": [kib, 1024] }
            - set: [idx, { "+": [idx, 1] }]
      - return: 0

- def:
    name: worker_count
    args: [[jobs, i32], [unit_count, i32], [peak_mib, i32]]
    return: i32
    body:
      - decl: [count, i32, jobs]
      - if: { condition: { lte: [count, 0] }, then: [{ set: [count, { call: [sys.logical_thread_count] }] }] }
      - decl: [free_mib, i32, { call: [available_mib] }]
      - if:
          condition: { "&&": [{ gt: [free_mib, 0] }, { gt: [peak_mib, 0] }] }
          then:
            - decl: [by_ram, i32, { "/": [free_mib, peak_mib] }]
            - if: { condition: { lt: [by_ram, count] }, then: [{ set: [count, by_ram] }] }
      - if: { condition: { lt: [unit_count, count] }, then: [{ set: [count, unit_count] }] }
      - if: { condition: { lt: [count, 1] }, then: [{ set: [count, 1] }] }
      - return: count
