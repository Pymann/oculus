# Preprocessor directives (doc/ir.md, section 5.5): one record per #define,
# #undef, #pragma (or _Pragma) and #include of active code outside system headers,
# and per expansion of a system macro there, in
# source order.  `pos` is the # of the directive (a _Pragma written in a macro body:
# its place in the #define).  Positions of a missing part have line 0.
#
# define: `body` the replacement tokens separated by single spaces (at most about
# 4 KB), the parameter facts, the # and ## operators (# counts only in
# function-like macros), `uses_call_site` when the body names __FILE__, __LINE__,
# __func__ and the like or a macro that does.  undef: `defined_file_uid` the file
# of the definition it removes, -1 if the name was not defined, -2 if it was
# defined outside any file (command line, predefines).  pragma: `body` the text
# from the # (or _Pragma) to the end of the line.
#
# include: an #include of the user; `name` the header as written without the
# brackets or quotes, `body` with them, `defined_file_uid` the file entered (a
# header skipped by its include guard is not entered again and not recorded).
# expansion: a macro of a system header expanded in the user's code (NULL, errno,
# offsetof ...); `pos` where its name is spelled (in a macro body of the user: that
# body), `name_pos` the expansion in the file, `defined_file_uid` the header; a
# one-argument macro has its argument tokens in `body` and `argument_pos`.
# define and undef: `scope` the innermost function body, class or namespace around
# the directive (function, class, namespace; "" at global scope).

- import: "src/ir/position.aiml"

- model:
    name: IrMacro
    fields:
      - [uid, i32, -1]
      - [kind, string, ""]
      - [name, string, ""]
      - [body, string, ""]
      - [pos, IrPos]
      - [name_pos, IrPos]
      - [function_like, bool, false]
      - [variadic, bool, false]
      - [param_count, i32, 0]
      - [stringize_count, i32, 0]
      - [paste_count, i32, 0]
      - [first_operator, IrPos]
      - [second_operator, IrPos]
      - [stringize_paste, IrPos]
      - [uses_call_site, bool, false]
      - [line_count, i32, 1]
      # define over several lines: the first backslash that continues a line
      - [splice_pos, IrPos]
      - [argument_pos, IrPos]
      - [scope, string, ""]
      - [defined_file_uid, i32, -1]
