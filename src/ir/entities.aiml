# Files, types and declarations of one translation unit (doc/ir.md, sections 2
# and 5).  Every record has a dense `uid` that is its index in its table;
# references to other records are uids, -1 meaning "none".

- import: "src/ir/position.aiml"

# kind: "source" (the main file), "header" or "system_header".
- model:
    name: IrFile
    fields:
      - [uid, i32, -1]
      - [path, string, ""]
      - [kind, string, ""]
      - [is_main, bool, false]
      # headers: protected against a second inclusion (an #ifndef guard around
      # all code, or several guarded blocks, or #pragma once; a header of
      # directives only counts as protected), else the first token of code
      # outside a guard; and whether it is included inside a declaration (a data
      # or X-macro file)
      - [include_guarded, bool, true]
      - [first_line, i32, 0]
      - [first_column, i32, 0]
      - [included_in_declaration, bool, false]
      # source files and headers: one character per physical line, Oculus' own line
      # counting: b blank, c comment only, x code only, m code and comment
      - [line_classes, string, ""]
      - [lexical_marks, string, ""]

# One type without qualifiers.  `sugar_uid` is the next step of the typedef or
# alias chain (-1 at its end), `canonical_uid` the type with all sugar removed.
# The integer fields describe builtin types; `kind` is informative only.
- model:
    name: IrType
    fields:
      - [uid, i32, -1]
      - [kind, string, ""]
      - [name, string, ""]
      - [canonical_uid, i32, -1]
      - [sugar_uid, i32, -1]
      - [decl_uid, i32, -1]
      - [is_typedef, bool, false]
      - [is_builtin, bool, false]
      - [is_bool, bool, false]
      - [is_integer, bool, false]
      - [int_signed, bool, false]
      - [int_width, i32, 0]
      - [plain_char, bool, false]
      - [is_enum, bool, false]
      - [is_record, bool, false]
      - [is_dependent, bool, false]
      - [enum_underlying_uid, i32, -1]
      # arrays: "" | constant | incomplete | variable | dependent; element_uid is
      # also the pointee of a pointer
      - [array_kind, string, ""]
      - [array_size, i32, -1]
      - [element_uid, i32, -1]
      - [is_pointer, bool, false]

# One declaration.  `pos` is the start of the declaration (its type specifiers),
# `name_pos` the declared name, `instantiation_pos` the point of instantiation
# when the declaration belongs to a template instantiation (origin.instantiated).  `written_builtin` and `sign_written` keep the type
# as spelled: plain `int` and `signed int` are one type, only the spelling differs.
- model:
    name: IrDecl
    fields:
      - [uid, i32, -1]
      - [kind, string, ""]
      - [name, string, ""]
      - [pos, IrSrcPos]
      - [name_pos, IrPos]
      - [origin, IrOrigin]
      - [instantiation_pos, IrPos]
      - [type_uid, i32, -1]
      - [parent_uid, i32, -1]
      - [is_definition, bool, false]
      - [is_bit_field, bool, false]
      - [bit_width, i32, -1]
      - [written_builtin, bool, false]
      - [sign_written, string, ""]
      # struct | union | class | enum, for tag declarations
      - [tag, string, ""]
      # the written storage class: "" | static | extern | register | auto
      - [storage, string, ""]
      - [is_inline, bool, false]
      - [is_local, bool, false]
      - [is_param, bool, false]
      - [param_count, i32, -1]
      - [virtual_bases, i32, 0]
      - [is_scoped, bool, false]
      # enum with a written underlying type
      - [is_fixed, bool, false]
      - [has_init, bool, false]
      # a const variable whose initializer is a constant expression
      - [constant_init, bool, false]
      - [overrides, i32, 0]
      - [override_written, bool, false]
      - [is_noreturn, bool, false]
      - [returns_void, bool, false]
      - [explicit_specialization, bool, false]
      - [has_restrict, bool, false]
      - [in_extern_c, bool, false]
      - [is_main, bool, false]
      # position in its list: field, enumerator or parameter
      - [group_uid, i32, -1]
      - [field_index, i32, -1]
      - [field_count, i32, -1]
      # using directive: the nominated namespace (qualified)
      - [target, string, ""]
      # inside a template instantiation (any enclosing function or class)
      - [in_instantiation, bool, false]
      # the array bound is written as a plain integer literal
      - [array_size_literal, bool, false]
      # static local: modified, or its address escapes, in its function
      - [is_mutated, bool, false]
      # the first declaration of the entity in the unit
      - [is_first_decl, bool, true]
      # methods: `virtual` written on this declaration
      - [virtual_written, bool, false]
      # an explicit specialisation of a function template (not of a member of a
      # class template)
      - [template_specialization, bool, false]
      # functions and variables with external linkage
      - [external_linkage, bool, false]
      # functions and variables with internal linkage; the entity's first
      # declaration says static
      - [internal_linkage, bool, false]
      - [first_decl_static, bool, false]
      # a function or variable definition with external linkage that every unit
      # including it repeats (not inline, templated, weak or tentative)
      - [odr_definition, bool, false]
      # a local `T (name);`: the name alone in parentheses, no initializer
      - [paren_declarator, bool, false]
      # constructors and conversion functions declared explicit
      - [is_explicit, bool, false]
      # functions defined as deleted
      - [is_deleted, bool, false]
      # functions defined as defaulted (written, or implied for special members)
      - [is_defaulted, bool, false]
      # functions: the arguments a call needs, default arguments not counted
      - [min_args, i32, -1]
      # where the written type starts (functions: the return type)
      - [type_pos, IrPos]
      # the first restrict keyword of the declarator (has_restrict)
      - [restrict_pos, IrPos]
      # where the declarator starts: `*p` at the *, otherwise the name
      - [declarator_pos, IrPos]
      # function definitions (not lambdas): the first token of the definition (the
      # template head, if any) and the closing brace of the body, at the expansion;
      # the preprocessing tokens of the body as written, braces included (-1 unknown)
      - [def_begin, IrPos]
      - [body_end, IrPos]
      - [body_tokens, i32, -1]
      # parameters: written with array syntax, and the `static` in its brackets
      - [array_param, bool, false]
      - [static_array_pos, IrPos]
      # constructors: a copy or move constructor
      - [copy_or_move, bool, false]
      # alignas specifiers written here (not inherited): how many, the second one,
      # and an alignment that evaluates to zero
      - [align_count, i32, 0]
      - [second_align_pos, IrPos]
      - [zero_align_pos, IrPos]
      # the * of the outermost pointer of the written type
      - [pointer_pos, IrPos]
      # member functions: "", "&" or "&&"; functions: "reference" or "pointer"
      # when the return type is one; variables and parameters: named somewhere; marked
      # [[maybe_unused]] or __attribute__((unused))
      - [ref_qualifier, string, ""]
      - [returns_kind, string, ""]
      - [is_referenced, bool, false]
      - [maybe_unused, bool, false]
      # parameters of a definition: the name is written in the body as a token
      # (also in a macro argument, skipped code, an inactive assert)
      - [named_in_body, bool, false]
      # local variables: how often the name is written in the function body (the
      # declaration included, -1 unknown); a handler or range-for variable, a
      # structured binding or of class type
      - [name_count, i32, -1]
      - [special_local, bool, false]
      # class definitions: abstract with a public copy assignment; a one-argument
      # constructor template without a user-declared copy constructor; an operator=
      # template without a user-declared copy assignment
      - [abstract_public_copy, bool, false]
      - [template_ctor_no_copy, bool, false]
      - [template_assign_no_copy, bool, false]
      # functions that must not throw and are not noexcept; destructors noexcept(false)
      - [may_throw, bool, false]
      # pure virtual functions overriding one that is not pure
      - [pure_overrides_impl, bool, false]
      - [enum_value, string, ""]
      - [designated_array, bool, false]
      # overriders: a default argument that differs from the overridden function's
      - [default_arg_pos, IrPos]
