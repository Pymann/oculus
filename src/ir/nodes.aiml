# Statements and expressions (doc/ir.md, section 5.4): one table, a tree per
# function body or initializer through `parent_uid`.  Recorded outside system
# headers and outside template instantiations (the template itself is recorded);
# implicit casts are not recorded yet.  `kind` is the frontend's node class
# (GotoStmt, BinaryOperator, CXXReinterpretCastExpr ...), `detail` the operator,
# cast or label spelling.  `in_system_header` means the node is spelled in a
# system header, i.e. it comes from a system macro.
#
# Details by kind: BinaryOperator/UnaryOperator the operator, CXX*CastExpr the cast
# name, GotoStmt/LabelStmt the label (ref_uid the label declaration, also for
# AddrLabelExpr), MemberExpr "." or "->" (ref_uid the member), IntegerLiteral its
# value, CXXCatchStmt "..." for catch (...), SwitchStmt "default" when it has one,
# DefaultStmt first/last/middle/only among its switch's labels in source order.
# Two kinds are markers, not Clang nodes: CXXBaseSpecifier (a base of a class
# definition, detail "virtual"; ref_uid the class) and OpenElseIfChain (at the
# `else` of an if whose `else if` has no `else`).

- import: "src/ir/position.aiml"

- model:
    name: IrNode
    fields:
      - [uid, i32, -1]
      - [kind, string, ""]
      - [detail, string, ""]
      - [pos, IrSrcPos]
      - [in_system_header, bool, false]
      - [from_macro, bool, false]
      - [parent_uid, i32, -1]
      - [function_uid, i32, -1]
      - [ref_uid, i32, -1]
      - [child_count, i32, 0]
      # expressions: their type, and whether it depends on a template parameter
      - [type_uid, i32, -1]
      - [is_dependent, bool, false]
      # switch: number of case/default labels, and of clauses (label groups)
      - [label_count, i32, -1]
      - [clause_count, i32, -1]
      # switch, if and function bodies: code inside was skipped by #if; another
      # configuration of the build may compile more of it
      - [has_skipped_code, bool, false]
      # literals: the characters as written in the file that spells them ("" when
      # the pieces come from different places or from ##)
      - [spelling, string, ""]
      # then | else | body: this node is that sub-statement of its parent; init
      # (the init statement of for, if, switch) and step (the increment of for)
      - [role, string, ""]
      # NullStmt: the character before it on its line ("" if it starts the line)
      - [before, string, ""]
      # the key token (keyword, binary operator, the ? of ?:) is written in a macro
      # body, not in the file or in a macro argument
      - [macro_body, bool, false]
      # sizeof and alignof of an expression: the operand has a side effect (calls
      # not counted) and is not evaluated
      - [side_effect, bool, false]
