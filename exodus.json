{
  "$schema": "exodus.project.config-1.0",
  "name": "oculus",
  "version": "0.0.1",
  "license": [],
  "output_type": "executable",
  "sources": ["src/main.aiml"],
  "compiler": { "name": "$AIML" },
  "linker": {
    "name": "g++",
    "flags": ["-Lout/lib", "-Wl,-rpath,$ORIGIN/../lib"],
    "libraries": ["aiml", "oculus_clang", "pthread", "dl", "m"],
    "library_paths": ["$AIML_VENV/lib"]
  }
}
